                                                lead-color: root.hint-violet;
                                                detail: @tr("一个刻度覆盖全部格式，AWJ 自动映射到各编码器的 crf / quality。默认值取开发者判定的视觉无损点：AVIF 70、WebP 95、JXL 85、JPGLI 90。这一项主要影响文件体积。JPEG 转 JXL 默认走无损转封装。");
                                                detail-color: root.text-muted;
                                            }
                                        }

                                        HorizontalLayout {
                                            min-height: 64px;
                                            spacing: 10px;
                                            cross-axis-alignment: center;
                                            Text { text: @tr("视觉质量"); width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                            LineEdit { accessible-label: @tr("视觉质量"); text <=> root.visual-quality-text; placeholder-text: @tr("空由质量决定，1-100"); input-type: number; enabled: !root.running; width: root.parameter-control-width; height: root.parameter-control-height; }
                                            ParamHint {
                                                horizontal-stretch: 1;
                                                lead: @tr("建议留空");
                                                lead-color: root.hint-red;
                                                detail: @tr("填写后会对同一张图反复编码，用 GMSD / MS-SSIM 搜索目标画质，效果类似质量驱动的 VBR，但耗时会翻数倍。");
                                                detail-color: root.text-muted;
                                            }
                                        }

                                        if root.format-index != 3: HorizontalLayout {
                                            min-height: 56px;
                                            spacing: 10px;
                                            cross-axis-alignment: center;
                                            Text { text: @tr("速度"); width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                            LineEdit { accessible-label: @tr("速度"); text <=> root.speed-text; placeholder-text: @tr("默认/可选0-10"); enabled: !root.running; width: root.parameter-control-width; height: root.parameter-control-height; }
                                            ParamHint {
                                                horizontal-stretch: 1;
                                                lead: @tr("0-10，越大越快");
