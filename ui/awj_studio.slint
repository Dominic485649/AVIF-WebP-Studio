                                spacing: root.page-gap;
                                SoftButton { dark-mode: root.dark-mode; text: root.running ? (root.force-terminate-supported ? "强制终止" : "停止任务") : "开始转换"; variant: root.running && root.force-terminate-supported ? "danger" : "action"; height: 42px; enabled: true; horizontal-stretch: 1; clicked => { root.start-conversion(); } }
                                if root.force-terminate-supported: SoftButton { dark-mode: root.dark-mode; text: "停止任务"; variant: "outline"; height: 42px; enabled: root.running; horizontal-stretch: 1; clicked => { root.cancel-conversion(); } }
                                SoftButton { dark-mode: root.dark-mode; text: "清空队列"; height: 42px; enabled: !root.running; horizontal-stretch: 1; clicked => { root.clear-tasks(); } }
                            }

                        }
                    }

                    Rectangle {
                        border-radius: 8px;
                        background: root.panel-bg;
                        border-color: root.panel-border;
                        border-width: 1px;
                        vertical-stretch: 1;
                        animate background, border-color { duration: 180ms; easing: ease-out; }

                        VerticalLayout {
                            padding: 18px;
                            spacing: 10px;

                            Rectangle {
                                vertical-stretch: 1;
                                border-radius: 6px;
                                background: root.dark-mode ? #151b25 : #ffffff;
                                border-color: root.panel-border;
                                border-width: 1px;
                                clip: true;
                                animate background, border-color { duration: 180ms; easing: ease-out; }

                                VerticalLayout {
                                    spacing: 0px;

                                    Rectangle {
                                        height: 34px;
                                        background: root.field-bg;
                                        border-color: root.field-border;
                                        border-width: 0px;
                                        animate background, border-color { duration: 180ms; easing: ease-out; }
                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 10px;
                                            Text { text: "#"; width: 40px; color: root.text-muted; font-size: 12px; vertical-alignment: center; horizontal-alignment: center; }
                                            Text { text: "文件名"; width: root.queue-filename-width; color: root.text-muted; font-size: 12px; vertical-alignment: center; }
                                            Text { text: "目录"; horizontal-stretch: 1; color: root.text-muted; font-size: 12px; vertical-alignment: center; }
                                            Text { text: "大小"; width: root.queue-size-width; color: root.text-muted; font-size: 12px; vertical-alignment: center; }
                                            Text { text: "状态"; width: root.queue-status-width; color: root.text-muted; font-size: 12px; vertical-alignment: center; }
                                            Text { text: "输出或日志"; horizontal-stretch: 1; color: root.text-muted; font-size: 12px; vertical-alignment: center; }
                                        }
                                    }

                                    Rectangle {
                                        vertical-stretch: 1;
                                        background: root.dark-mode ? #151b25 : #ffffff;

                                        if root.task-rows.length == 0: Text {
                                            text: "队列为空";
                                            color: root.text-muted;
                                            font-size: 13px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        if root.task-rows.length > 0: ListView {
                                     for row[index] in root.task-rows: drop-row := DropArea {
                                         property <length> hover-y: 0px;
                                         property <int> drop-index: index + (drop-row.hover-y > drop-row.height / 2 ? 1 : 0);
                                         width: parent.width;
                                         height: 34px;
                                         can-drop(event) => {
                                             drop-row.hover-y = event.position.y;
                                             return root.queue-drag-can-drop(event, drop-row.drop-index);
                                         }
                                         dropped(event) => {
                                             return root.queue-drag-dropped(event, drop-row.drop-index);
                                         }
                                         row-drag := DragArea {
                                             enabled: !root.running && !row.locked;
                                             allow-move: !root.running && !row.locked;
                                             data: root.queue-drag-data(index);
                                             opacity: row-drag.dragging ? 0.45 : 1.0;
                                             Rectangle {
                                                 width: parent.width;
                                                 height: parent.height;
                                                 background: drop-row.has-drag ? (root.dark-mode ? #24324a : #e7f1ff) : (row-touch.has-hover ? (root.dark-mode ? #222d3c : #edf5ff) : (index / 2 * 2 == index ? (root.dark-mode ? #1c2533 : #f4f8fe) : transparent));
                                                 border-radius: 6px;
                                                 animate y, background { duration: 190ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }
                                                 HorizontalLayout {
                                                     padding-left: 10px;
                                                     padding-right: 10px;
                                                     spacing: 10px;
                                                     Text { text: row.order; width: 40px; color: root.text-muted; font-size: 12px; vertical-alignment: center; horizontal-alignment: center; }
                                                     Text { text: row.filename; width: root.queue-filename-width; color: root.text-body; font-size: 12px; overflow: elide; vertical-alignment: center; }
                                                     Text { text: row.folder; horizontal-stretch: 1; color: root.text-muted; font-size: 12px; overflow: elide; vertical-alignment: center; }
                                                     Text { text: row.size; width: root.queue-size-width; color: root.text-muted; font-size: 12px; vertical-alignment: center; }
                                                     Text { text: row.status; width: root.queue-status-width; color: row.warning ? root.warning : root.text-body; font-size: 12px; overflow: elide; vertical-alignment: center; }
                                                     Text { text: row.output.is-empty ? row.log : row.output; horizontal-stretch: 1; color: row.warning ? root.warning : root.text-muted; font-size: 12px; overflow: elide; vertical-alignment: center; }
                                                 }
                                                 row-touch := TouchArea {
                                                     width: parent.width;
                                                     height: parent.height;
                                                     pointer-event(event) => {
                                                         if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                                                             root.queue-menu-index = index;
                                                             root.queue-menu-x = max(0px, min(root.width - root.queue-menu-width - 10px, row-touch.absolute-position.x + row-touch.mouse-x));
                                                             root.queue-menu-y = max(0px, min(root.height - root.queue-menu-height - 10px, row-touch.absolute-position.y + row-touch.mouse-y));
                                                             root.queue-menu-origin-x = max(0px, row-touch.absolute-position.x + row-touch.mouse-x - root.queue-menu-x);
                                                             root.queue-menu-origin-y = max(0px, row-touch.absolute-position.y + row-touch.mouse-y - root.queue-menu-y);
                                                             root.queue-menu-opening = false;
                                                             root.queue-menu-visible = false;
                                                             queue-menu-popup.show();
                                                             root.queue-menu-opening = true;
                                                         }
                                                         root.queue-row-pointer-event(
                                                             index,
                                                             event.button == PointerEventButton.left ? 0 : (event.button == PointerEventButton.right ? 1 : 2),
                                                             event.kind == PointerEventKind.down ? 0 : (event.kind == PointerEventKind.up ? 1 : (event.kind == PointerEventKind.move ? 2 : 3)),
                                                             row-touch.mouse-y / 1px
                                                         );
                                                     }
                                                 }
                                             }
                                         }
                                         if drop-row.has-drag: Rectangle {
                                             y: drop-row.hover-y > drop-row.height / 2 ? parent.height - 2px : 0px;
                                             width: parent.width;
                                             height: 2px;
                                             background: root.accent-strong;
                                             border-radius: 1px;
                                         }
                                     }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                height: 10px;
                                border-radius: 5px;
                                background: root.progress-track;
                                clip: true;
                                animate background { duration: 180ms; easing: ease-out; }
                                Rectangle {
                                    x: 0px;
                                    width: max(0px, min(parent.width, parent.width * root.progress));
                                    height: parent.height;
                                    border-radius: 5px;
                                    background: root.progress-fill;
                                    animate width, background { duration: 160ms; easing: ease-out; }
                                }
                            }

                            Text { text: "总进度：" + root.status-text; color: root.text-muted; font-size: 12px; overflow: elide; }
                        }
                    }
                }

if root.selected-page == 2: ScrollView {
                    VerticalLayout {
                        spacing: root.page-gap;

                        Rectangle {
                            border-radius: 8px;
                            background: root.panel-bg;
                            border-color: root.panel-border;
                            border-width: 1px;
                            animate background, border-color { duration: 180ms; easing: ease-out; }
                            VerticalLayout {
                                padding: 24px;
                                spacing: root.page-gap;
                                Text { text: "外观"; color: root.text-strong; font-size: 18px; font-weight: 800; }
                                HorizontalLayout {
                                    spacing: root.page-gap;
                                    Text { text: "主题"; width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                    SoftComboBox {
                                                viewport-height: root.height;
                                        close-generation: root.combo-close-generation;
                                        popup-requested => { root.combo-popup-requested(); }
                                        popup-finished => { root.combo-popup-finished(); }
                                        model: [{ text: "跟随系统", enabled: true }, { text: "浅色", enabled: true }, { text: "深色", enabled: true }];
                                        current-index <=> root.theme-index;
                                        horizontal-stretch: 1;
                                        normal-background: root.combo-bg;
                                        hover-background: root.combo-bg-hover;
                                        disabled-background: root.combo-bg-disabled;
                                        selected-background: root.combo-selected-bg;
                                        normal-border: root.combo-border;
                                        hover-border: root.combo-border-hover;
                                        normal-text: root.text-body;
                                        disabled-text: root.text-soft;
                                        muted-text: root.text-muted;
                                        selected-text: root.accent-strong;
                                        selection-accepted(index, click-x, click-y) => {
                                            root.theme-selection-requested(index, click-x, click-y);
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: root.page-gap;
                                    Text { text: "字体"; width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                    SoftComboBox {
                                        viewport-height: root.height;
                                        max-visible-items: 10;
                                        close-generation: root.combo-close-generation;
                                        popup-requested => { root.combo-popup-requested(); }
                                        popup-finished => { root.combo-popup-finished(); }
                                        model: root.ui-font-options;
                                        current-index <=> root.ui-font-index;
                                        enabled: !root.running;
                                        horizontal-stretch: 1;
                                        height: root.control-button-height;
                                        normal-background: root.combo-bg;
                                        hover-background: root.combo-bg-hover;
                                        disabled-background: root.combo-bg-disabled;
                                        selected-background: root.combo-selected-bg;
                                        normal-border: root.combo-border;
                                        hover-border: root.combo-border-hover;
                                        normal-text: root.text-body;
                                        disabled-text: root.text-soft;
                                        muted-text: root.text-muted;
                                        selected-text: root.text-body;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            border-radius: 8px;
                            background: root.panel-bg;
                            border-color: root.panel-border;
                            border-width: 1px;
                            animate background, border-color { duration: 180ms; easing: ease-out; }
                            VerticalLayout {
                                padding: 24px;
                                spacing: root.page-gap;
                                Text { text: "高级与实验功能"; color: root.text-strong; font-size: 18px; font-weight: 800; }
                                if root.wic-ui-visible: VerticalLayout {
                                    spacing: 8px;
                                    CheckBox { text: "允许 WIC 兜底"; checked <=> root.allow-wic-fallback; enabled: !root.running; }
                                    Text { text: "开启后，若内置的专业级 Native 解码器（如 libavif, libwebp）加载图片失败，系统将自动尝试使用 Windows WIC（Windows Imaging Component）作为兜底解码路径。"; color: root.text-muted; font-size: 13px; wrap: word-wrap; }
                                }
                                VerticalLayout {
                                    spacing: 8px;
                                    CheckBox { text: "GPU 加速视觉质量"; checked <=> root.visual-quality-gpu; enabled: !root.running; }
                                    Text { text: root.visual-quality-gpu-help-text; color: root.text-muted; font-size: 13px; wrap: word-wrap; }
                                }
                                VerticalLayout {
                                    spacing: 8px;
                                    CheckBox { text: "视觉质量未达标时兜底输出"; checked <=> root.visual-quality-fallback; enabled: !root.running; }
                                    Text { text: "填写视觉质量后生效；未填写视觉质量时此选项保持可选，但不会参与本次编码。启用后，visual_quality 搜索没有候选达到目标时仍输出最接近目标的候选；关闭时未达标会失败。"; color: root.text-muted; font-size: 13px; wrap: word-wrap; }
                                }

                                VerticalLayout {
                                    spacing: 8px;
                                    CheckBox { text: "解除 20 GiB 输入/运行时上限"; checked <=> root.unlock-max-input-file-bytes; enabled: !root.running; }
                                    Text { text: "仅当前会话生效，不会写入 AWJ.jsonc。"; color: root.text-muted; font-size: 13px; wrap: word-wrap; }
                                    Text { text: "警告：图片或工作集过大时可能导致内存耗尽、进程被系统杀死或整机卡死。仅在明确需要处理超大文件时临时开启。"; color: #d13438; font-size: 13px; wrap: word-wrap; font-weight: 700; }
                                }
                                VerticalLayout {
                                    spacing: 8px;
                                    CheckBox { text: "启用实验性编码器（zenrav1e）"; checked <=> root.experimental-encoders; enabled: !root.running; }
                                    Text { text: "启用后，构建支持时可在自动大图链路中使用 zenrav1e；普通队列自动不会选择实验编码器。不可用时相关路径会跳过或置灰。"; color: root.text-muted; font-size: 13px; wrap: word-wrap; }
                                }

                            }
                        }

                        Rectangle {
                            border-radius: 8px;
                            background: root.panel-bg;
                            border-color: root.panel-border;
                            border-width: 1px;
                            animate background, border-color { duration: 180ms; easing: ease-out; }
                            VerticalLayout {
                                padding: 24px;
                                spacing: root.page-gap;
                                Text { text: "关于后端"; color: root.text-strong; font-size: 18px; font-weight: 800; }
                                Text { text: "当前内置后端：原生编解码器"; color: root.text-body; font-size: 14px; }
                                Text { text: "Studio 输出：libavif / AOM、svt-av1-hdr、实验 zenrav1e、WebP、JXL、JPGLI；PNG 仅 CLI 和右键菜单。"; color: root.text-body; font-size: 14px; }
                                Text { text: "编码流程统一使用内置原生后端。"; color: root.text-muted; font-size: 13px; }
                            }
                        }
                    }
                }
            }
        }

        queue-menu-popup := PopupWindow {
            x: root.queue-menu-x;
            y: root.queue-menu-y;
            width: root.queue-menu-width;
            height: root.queue-menu-height;
            close-policy: close-on-click-outside;

            menu-open-timer := Timer {
                interval: 20ms;
                running: root.queue-menu-opening;
                triggered => {
                    root.queue-menu-visible = true;
                    root.queue-menu-opening = false;
                }
            }

            menu-close-timer := Timer {
                interval: 160ms;
                running: false;
                triggered => {
                    root.queue-menu-opening = false;
                    queue-menu-popup.close();
                    self.stop();
                }
            }

            Rectangle {
                x: root.queue-menu-visible ? 0px : root.queue-menu-origin-x;
                y: root.queue-menu-visible ? 0px : root.queue-menu-origin-y;
                width: root.queue-menu-visible ? parent.width : 0px;
                height: root.queue-menu-visible ? parent.height : 0px;
                border-radius: 6px;
                border-width: 1px;
                border-color: root.panel-border;
                background: root.dark-mode ? #17202c : #ffffff;
                clip: true;
                animate x, y, width, height { duration: 220ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }

                VerticalLayout {
                    padding: 6px;
                    spacing: 2px;
                    QueueMenuItem { dark-mode: root.dark-mode; text: "打开所在位置"; enabled: root.queue-menu-valid; clicked => { root.queue-menu-action(root.queue-menu-index, "open-folder"); root.queue-menu-opening = false; root.queue-menu-visible = false; menu-close-timer.restart(); } }
                    QueueMenuItem { dark-mode: root.dark-mode; text: "默认方式打开图片"; enabled: root.queue-menu-valid; clicked => { root.queue-menu-action(root.queue-menu-index, "open-image"); root.queue-menu-opening = false; root.queue-menu-visible = false; menu-close-timer.restart(); } }
                    QueueMenuItem { dark-mode: root.dark-mode; text: "优先编码"; enabled: root.queue-menu-editable && !root.running; clicked => { root.queue-menu-action(root.queue-menu-index, "priority"); root.queue-menu-opening = false; root.queue-menu-visible = false; menu-close-timer.restart(); } }
                    QueueMenuItem { dark-mode: root.dark-mode; text: "最后编码"; enabled: root.queue-menu-editable && !root.running; clicked => { root.queue-menu-action(root.queue-menu-index, "last"); root.queue-menu-opening = false; root.queue-menu-visible = false; menu-close-timer.restart(); } }
                    QueueMenuItem { dark-mode: root.dark-mode; text: "上移"; enabled: root.queue-menu-editable && !root.running; clicked => { root.queue-menu-action(root.queue-menu-index, "move-up"); root.queue-menu-opening = false; root.queue-menu-visible = false; menu-close-timer.restart(); } }
                    QueueMenuItem { dark-mode: root.dark-mode; text: "下移"; enabled: root.queue-menu-editable && !root.running; clicked => { root.queue-menu-action(root.queue-menu-index, "move-down"); root.queue-menu-opening = false; root.queue-menu-visible = false; menu-close-timer.restart(); } }
                    QueueMenuItem { dark-mode: root.dark-mode; text: "复制完整路径"; enabled: root.queue-menu-valid; clicked => { root.queue-menu-action(root.queue-menu-index, "copy-path"); root.queue-menu-opening = false; root.queue-menu-visible = false; menu-close-timer.restart(); } }
                    QueueMenuItem { dark-mode: root.dark-mode; text: "从队列移除"; enabled: root.queue-menu-removable && !root.running; danger: true; clicked => { root.queue-menu-action(root.queue-menu-index, "remove"); root.queue-menu-opening = false; root.queue-menu-visible = false; menu-close-timer.restart(); } }
                }
            }
        }
    }
}


export component ShellConvertWindow inherits Window {
    title: "AWJimage 右键转换";
    icon: @image-url("logo.png");
    default-font-family: root.ui-font-family;
    preferred-width: 840px;
    preferred-height: 560px;
    min-width: 680px;
    min-height: 440px;

    in property <[TaskRow]> task-rows;
    in-out property <string> status-text: "正在准备任务…";
    in-out property <float> progress: 0.0;
    in-out property <bool> running: true;
    in-out property <bool> dark-mode: false;
    in-out property <string> ui-font-family: "";
    callback cancel-requested();
    callback force-terminate-requested();
    callback open-output-requested();

    property <color> page-bg: root.dark-mode ? #10151e : #f3f7fd;
    property <color> panel-bg: root.dark-mode ? #1b2330 : #ffffff;
    property <color> panel-border: root.dark-mode ? #303b4c : #dde7f3;
    property <color> row-bg: root.dark-mode ? #202a39 : #ffffff;
    property <color> text-strong: root.dark-mode ? #f5f8fc : #111827;
    property <color> text-body: root.dark-mode ? #dce5f1 : #334155;
    property <color> text-muted: root.dark-mode ? #a0aec2 : #64748b;
    property <color> accent: #0d6efd;
    property <color> progress-track: root.dark-mode ? #293445 : #dbe7f5;
    property <color> warning-color: root.dark-mode ? #f59e0b : #d97706;

    background: root.page-bg;

    VerticalLayout {
        padding: 20px;
        spacing: 14px;

        Text {
            text: "右键转换";
            color: root.text-strong;
            font-size: 22px;
            font-weight: 800;
            horizontal-alignment: left;
        }
        Text {
            text: root.status-text;
            color: root.text-muted;
            font-size: 12px;
            horizontal-alignment: left;
            overflow: elide;
        }
        Rectangle {
            height: 6px;
            border-radius: 3px;
            background: root.progress-track;
            Rectangle {
                width: max(0px, min(parent.width, parent.width * root.progress));
                height: parent.height;
                border-radius: 3px;
                background: root.accent;
                animate width { duration: 160ms; easing: ease-out; }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            border-radius: 8px;
            background: root.panel-bg;
            border-color: root.panel-border;
            border-width: 1px;
            clip: true;
            VerticalLayout {
                spacing: 0px;

                Rectangle {
                    height: 34px;
                    background: root.dark-mode ? #222c3b : #f8fbff;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 12px;
                        Text { text: "#"; width: 32px; color: root.text-muted; font-size: 11px; vertical-alignment: center; horizontal-alignment: center; }
                        Text { text: "文件"; horizontal-stretch: 1; color: root.text-muted; font-size: 11px; vertical-alignment: center; }
                        Text { text: "大小"; width: 82px; color: root.text-muted; font-size: 11px; vertical-alignment: center; horizontal-alignment: center; }
                        Text { text: "状态与输出"; width: 164px; color: root.text-muted; font-size: 11px; vertical-alignment: center; }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: root.panel-bg;

                    if root.task-rows.length == 0: Text {
                        text: "正在准备任务…";
                        color: root.text-muted;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    if root.task-rows.length > 0: ListView {
                        for row[i] in root.task-rows: Rectangle {
                            height: 64px;
                            background: i / 2 * 2 == i ? root.row-bg : root.panel-bg;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 12px;
                                Text { text: row.order; width: 32px; color: root.text-muted; font-size: 11px; vertical-alignment: center; horizontal-alignment: center; }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 3px;
                                    Text { text: row.filename; color: root.text-body; font-size: 13px; font-weight: 700; overflow: elide; horizontal-alignment: left; }
                                    Text { text: row.folder; color: root.text-muted; font-size: 10px; overflow: elide; horizontal-alignment: left; }
                                }
                                Text { text: row.size; width: 82px; color: root.text-muted; font-size: 11px; vertical-alignment: center; horizontal-alignment: center; }
                                VerticalLayout {
                                    width: 164px;
                                    alignment: center;
                                    spacing: 3px;
                                    Text { text: row.status; color: row.warning ? root.warning-color : root.text-body; font-size: 12px; overflow: elide; horizontal-alignment: left; }
                                    Text { text: row.output.is-empty ? row.log : row.output; color: root.text-muted; font-size: 10px; overflow: elide; horizontal-alignment: left; }
                                }
                            }
                            Rectangle {
                                y: parent.height - 1px;
                                width: parent.width;
                                height: 1px;
                                background: root.panel-border;
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            height: 40px;
            spacing: 10px;
            Rectangle { horizontal-stretch: 1; background: transparent; }
            SoftButton { dark-mode: root.dark-mode; text: "打开输出目录"; width: 132px; height: 40px; enabled: !root.running; clicked => { root.open-output-requested(); } }
            SoftButton { dark-mode: root.dark-mode; text: "强制终止"; variant: "danger"; width: 112px; height: 40px; enabled: root.running; clicked => { root.force-terminate-requested(); } }
            SoftButton { dark-mode: root.dark-mode; text: root.running ? "停止任务" : "关闭"; variant: "outline"; width: 92px; height: 40px; clicked => { root.cancel-requested(); } }
        }
    }
}
