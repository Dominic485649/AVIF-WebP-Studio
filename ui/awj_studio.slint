import { Button, CheckBox, LineEdit, Palette, ScrollView, ListView } from "std-widgets.slint";
import "./fonts/HarmonyOS_SansSC_Regular.ttf";

export struct TaskRow {
    filename: string,
    format: string,
    status: string,
    log: string,
}

export struct LargeImageRow {
    filename: string,
    dimensions: string,
    reason: string,
    actions: string,
    status: string,
}

export struct ComboOption {
    text: string,
    enabled: bool,
}

component SoftComboBox inherits Rectangle {
    in property <[ComboOption]> model;
    in-out property <int> current-index;
    in property <bool> enabled: true;
    out property <bool> has-hover <=> touch.has-hover;
    in property <color> normal-background: #fbfdff;
    in property <color> hover-background: #f3f8ff;
    in property <color> disabled-background: #eef2f7;
    in property <color> selected-background: #e7f1ff;
    in property <color> normal-border: #dfe8f3;
    in property <color> hover-border: #b9d6f7;
    in property <color> normal-text: #334155;
    in property <color> disabled-text: #94a3b8;
    in property <color> muted-text: #64748b;
    in property <color> selected-text: #0b5ed7;
    property <bool> popup-open: false;

    min-width: 128px;
    min-height: 38px;

    horizontal-stretch: 1;
    vertical-stretch: 0;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.has-hover ? root.hover-border : root.normal-border;
    background: root.enabled ? (root.has-hover ? root.hover-background : root.normal-background) : root.disabled-background;
    clip: true;
    animate background, border-color { duration: 150ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        spacing: 8px;
        Text {
            text: root.model[root.current-index].text;
            color: root.enabled ? root.normal-text : root.disabled-text;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
            animate color { duration: 150ms; easing: ease-out; }
        }
        Rectangle {
            width: 14px;
            height: 14px;
            y: (parent.height - 14px) / 2;
            Text {
                text: root.popup-open ? "▲" : "▼";
                color: root.muted-text;
                font-size: 10px;
                font-weight: 700;
                width: 14px;
                height: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
                y: root.popup-open ? 1px : 0px;
                animate y { duration: 120ms; easing: ease-out; }
            }
        }
    }

    touch := TouchArea {
        clicked => {
            if (root.enabled) {
                root.popup-open = true;
                popup.show();
            }
        }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: root.width;
        height: max(root.model.length, 1) * 36px + 8px;
        close-policy: close-on-click-outside;

        popup-container := Rectangle {
            property <bool> active: false;
            opacity: active ? 1.0 : 0.0;
            y: active ? 0px : -10px;
            animate opacity, y { duration: 180ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }
            init => { active = true; }

            border-radius: 8px;
            border-width: 1px;
            border-color: root.normal-border;
            background: root.normal-background;
            clip: true;

            VerticalLayout {
                padding: 4px;
                for option[index] in root.model: Rectangle {
                    height: 36px;
                    border-radius: 6px;
                    background: option.enabled && index == root.current-index ? root.selected-background : (option.enabled && item-touch.has-hover ? root.hover-background : transparent);
                    animate background { duration: 120ms; easing: ease-out; }

                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        text: option.text;
                        color: !option.enabled ? root.disabled-text : (index == root.current-index ? root.selected-text : root.normal-text);
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    item-touch := TouchArea {
                        clicked => {
                            if (option.enabled) {
                                root.current-index = index;
                                root.popup-open = false;
                                popup.close();
                            }
                        }
                    }
                }
            }
        }
    }
}

component SoftButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> checked: false;
    in property <string> variant: "outline"; // "outline" | "primary" | "danger" | "action"
    in property <bool> dark-mode: false;

    property <color> combo-bg: root.dark-mode ? #222c3b : #fbfdff;
    property <color> combo-bg-hover: root.dark-mode ? #293548 : #f3f8ff;
    property <color> combo-bg-disabled: root.dark-mode ? #1d2532 : #eef2f7;
    property <color> combo-selected-bg: root.dark-mode ? #14325b : #e7f1ff;
    property <color> combo-border: root.dark-mode ? #3a4658 : #dfe8f3;
    property <color> combo-border-hover: root.dark-mode ? #4d6684 : #b9d6f7;
    property <color> text-body: root.dark-mode ? #dce5f1 : #334155;
    property <color> text-soft: root.dark-mode ? #748299 : #94a3b8;
    property <color> accent-strong: root.dark-mode ? #5aa2ff : #0d6efd;

    out property <bool> has-hover <=> touch.has-hover;
    out property <bool> pressed <=> touch.pressed;
    callback clicked();

    min-height: 32px;
    vertical-stretch: 0;
    border-radius: root.has-hover ? 10px : 8px;
    border-width: root.variant == "outline" ? 1px : 0px;
    border-color: root.enabled ? (root.has-hover ? root.combo-border-hover : root.combo-border) : root.combo-border;

    background: !root.enabled ?
        root.combo-bg-disabled :
        (root.variant == "primary" ?
            (root.has-hover ? #0b5ed7 : #0d6efd) :
            (root.variant == "danger" ?
                (root.has-hover ? #b91c1c : #dc2626) :
                (root.variant == "action" ?
                    (root.has-hover ? #0a707e : #0f7c8c) :
                    (root.checked ?
                        root.combo-selected-bg :
                        (root.has-hover ? root.combo-bg-hover : root.combo-bg)
                    )
                )
            )
        );

    animate background, border-color, border-radius { duration: 150ms; easing: ease-out; }

    Rectangle {
        x: 0px;
        y: root.pressed ? 1.5px : 0px;
        width: parent.width;
        height: parent.height;
        animate y { duration: 60ms; easing: ease-out; }

        Text {
            text: root.text;
            color: !root.enabled ? root.text-soft : (root.checked ? root.accent-strong : (root.variant == "primary" || root.variant == "danger" || root.variant == "action" ? #ffffff : root.text-body));
            font-size: 13px;
            font-weight: root.variant == "primary" || root.variant == "action" || root.variant == "danger" || root.checked ? 700 : 500;
            horizontal-alignment: center;
            vertical-alignment: center;
            animate color { duration: 150ms; easing: ease-out; }
        }
    }

    touch := TouchArea {
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <brush> normal-background: transparent;
    in property <brush> hover-background: #eef6ff;
    in property <brush> selected-background: #0f7c8c;
    in property <color> normal-text: #334155;
    in property <color> selected-text: #ffffff;
    out property <bool> has-hover <=> touch.has-hover;
    callback clicked();

    height: 50px;
    border-radius: 12px;
    background: root.selected ? root.selected-background : (root.has-hover ? root.hover-background : root.normal-background);
    animate background { duration: 150ms; easing: ease-out; }

    // Dynamic vertical stripe on the left edge
    Rectangle {
        x: 8px;
        y: (parent.height - (root.selected ? 20px : 0px)) / 2;
        width: 4px;
        height: root.selected ? 20px : 0px;
        border-radius: 2px;
        background: #ffffff;
        animate height, y { duration: 180ms; easing: ease-out; }
    }

    Text {
        text: root.label;
        color: root.selected ? root.selected-text : root.normal-text;
        font-size: 18px;
        font-weight: 700;
        x: (parent.width - self.width) / 2 + (root.selected ? 6px : (root.has-hover ? 4px : 0px));
        vertical-alignment: center;
        animate x, color { duration: 150ms; easing: ease-out; }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}


export component AwjStudio inherits Window {
    title: "AWJ Studio";
    icon: @image-url("logo.png");
    default-font-family: "鸿蒙黑体";
    preferred-width: 1220px;
    preferred-height: 800px;
    min-width: 820px;
    min-height: 560px;

    in-out property <string> input-path: "input";
    in-out property <int> input-mode-index: 1;
    in-out property <string> output-dir: "";
    in-out property <int> format-index: 0;
    in-out property <int> avif-encoder-index: 0;
    in property <[ComboOption]> avif-encoder-options: [{ text: "auto", enabled: true }, { text: "svt-av1-hdr", enabled: true }, { text: "aom", enabled: true }, { text: "zenrav1e", enabled: false }];
    in-out property <bool> experimental-encoders: true;
    in-out property <string> avif-quality-default: "";
    in-out property <string> webp-quality-default: "";
    in-out property <string> jxl-quality-default: "";
    in-out property <string> webp-bit-depth-default: "";
    in-out property <string> quality-text: "";
    in-out property <string> visual-quality-text: "";
    in-out property <bool> allow-wic-fallback: true;
    in-out property <bool> quality-follows-format: true;
    in-out property <string> bit-depth-text: "";
    in-out property <bool> bit-depth-follows-format: true;
    in-out property <int> chroma-index: 0;
    in-out property <int> alpha-policy-index: 1;
    in-out property <string> threads-text: "";
    in-out property <string> memory-limit-text: "";
    in-out property <string> speed-text: "";
    in-out property <string> template-text: "";
    in-out property <bool> template-params-selected: false;
    in-out property <bool> template-date-selected: false;
    in-out property <bool> template-time-selected: false;
    in-out property <bool> template-rand-selected: false;
    in-out property <bool> template-hash8-selected: false;
    in-out property <int> collision-index: 0;
    in-out property <int> theme-index: 0;
    in-out property <bool> system-dark-mode: false;
    in-out property <bool> strip-metadata: false;
    in-out property <bool> write-summary: false;
    in-out property <bool> write-log: false;
    in-out property <bool> running: false;
    in-out property <float> progress: 0.0;
    in-out property <string> status-text: "就绪";
    in property <[TaskRow]> task-rows;
    in property <[LargeImageRow]> large-image-rows;
    in-out property <int> selected-large-image-index: -1;

    property <int> selected-page: 0;
    property <int> chroma-index-before-forced: 0;
    property <bool> chroma-forced-by-avif-encoder: false;
    property <bool> dark-mode: root.theme-index == 2 || (root.theme-index == 0 && root.system-dark-mode);
    property <color> page-bg: root.dark-mode ? #10151e : #f3f7fd;
    property <color> mica-tint: root.dark-mode ? #151c28 : #edf4ff;
    property <color> nav-bg: root.dark-mode ? #141b25 : #f8fbff;
    property <color> chrome-bg: root.dark-mode ? #18202c : #ffffff;
    property <color> panel-bg: root.dark-mode ? #1b2330 : #ffffff;
    property <color> panel-bg-soft: root.dark-mode ? #202a39 : #f8fbff;
    property <color> panel-border: root.dark-mode ? #303b4c : #dde7f3;
    property <color> field-bg: root.dark-mode ? #222c3b : #fbfdff;
    property <color> field-border: root.dark-mode ? #3a4658 : #e2eaf4;
    property <color> text-strong: root.dark-mode ? #f5f8fc : #111827;
    property <color> text-body: root.dark-mode ? #dce5f1 : #334155;
    property <color> text-muted: root.dark-mode ? #a0aec2 : #64748b;
    property <color> text-soft: root.dark-mode ? #748299 : #94a3b8;
    property <color> accent: #0d6efd;
    property <color> accent-strong: root.dark-mode ? #5aa2ff : #0b5ed7;
    property <color> accent-soft: root.dark-mode ? #14325b : #e7f1ff;
    property <color> success: #22b84c;
    property <color> success-soft: root.dark-mode ? #143522 : #eaf8ef;
    property <color> warning: #d97706;
    property <color> warning-soft: root.dark-mode ? #332816 : #fff7e8;
    property <color> progress-track: root.dark-mode ? #293445 : #dbe7f5;
    property <brush> progress-fill: root.running ? #0d6efd : #22b84c;

    property <color> combo-bg: root.dark-mode ? #222c3b : #fbfdff;
    property <color> combo-bg-hover: root.dark-mode ? #293548 : #f3f8ff;
    property <color> combo-bg-disabled: root.dark-mode ? #1d2532 : #eef2f7;
    property <color> combo-selected-bg: root.dark-mode ? #14325b : #e7f1ff;
    property <color> combo-border: root.dark-mode ? #3a4658 : #dfe8f3;
    property <color> combo-border-hover: root.dark-mode ? #4d6684 : #b9d6f7;

    callback browse-input();
    callback open-input();
    callback browse-output();
    callback open-output();
    callback start-conversion();
    callback cancel-conversion();
    callback clear-tasks();
    callback large-image-action-requested(int, string);
    callback format-defaults-requested(int);
    callback toggle-template-token(string);

    init => {
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }

    changed dark-mode => {
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }

    changed format-index => {
        root.format-defaults-requested(root.format-index);
        if (!(root.format-index == 0 && root.avif-encoder-index == 1) && root.chroma-forced-by-avif-encoder) {
            root.chroma-index = root.chroma-index-before-forced;
            root.chroma-forced-by-avif-encoder = false;
        }
        if (root.format-index == 0 && root.avif-encoder-index == 1 && !root.chroma-forced-by-avif-encoder) {
            root.chroma-index-before-forced = root.chroma-index;
            root.chroma-index = 3;
            root.chroma-forced-by-avif-encoder = true;
        }
    }

    changed experimental-encoders => {
        root.format-defaults-requested(root.format-index);
    }

    changed avif-encoder-index => {
        if (root.format-index == 0 && root.avif-encoder-index == 1) {
            if (!root.chroma-forced-by-avif-encoder) {
                root.chroma-index-before-forced = root.chroma-index;
                root.chroma-forced-by-avif-encoder = true;
            }
            root.chroma-index = 3;
        } else if (root.chroma-forced-by-avif-encoder) {
            root.chroma-index = root.chroma-index-before-forced;
            root.chroma-forced-by-avif-encoder = false;
        }
    }

    changed quality-text => {
        root.quality-follows-format =
            (root.format-index == 0 && root.quality-text == root.avif-quality-default)
            || (root.format-index == 1 && root.quality-text == root.webp-quality-default)
            || (root.format-index == 2 && root.quality-text == root.jxl-quality-default);
    }

    changed bit-depth-text => {
        root.bit-depth-follows-format = root.format-index == 1 ? root.bit-depth-text == root.webp-bit-depth-default : root.bit-depth-text.is-empty;
    }

    background: root.page-bg;

    Rectangle {
        background: root.page-bg;
        animate background { duration: 180ms; easing: ease-out; }

        Rectangle {
            x: 0px;
            y: 0px;
            width: 232px;
            height: parent.height;
            background: root.nav-bg;
            animate background { duration: 180ms; easing: ease-out; }
        }

        Rectangle {
            x: 232px;
            y: 0px;
            width: 1px;
            height: parent.height;
            background: root.panel-border;
            animate background { duration: 180ms; easing: ease-out; }
        }

        Rectangle {
            x: 236px;
            y: 18px;
            width: parent.width - 254px;
            height: parent.height - 36px;
            border-radius: 24px;
            background: root.mica-tint;
            opacity: 0.56;
            animate background { duration: 180ms; easing: ease-out; }
        }

        HorizontalLayout {
            padding-top: 14px;
            padding-bottom: 14px;
            padding-right: 14px;
            spacing: 14px;

            Rectangle {
                width: 220px;
                background: transparent;

                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    Rectangle {
                        height: 52px;
                        background: transparent;
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "AWJ Studio"; color: root.text-strong; font-size: 24px; font-weight: 900; letter-spacing: 0.5px; }
                            Rectangle {
                                width: 56px;
                                height: 3px;
                                border-radius: 1.5px;
                                background: #0f7c8c;
                            }
                        }
                    }

                    Rectangle { height: 8px; background: transparent; }

                    NavItem {
                        label: "编码队列";
                        selected: root.selected-page == 1;
                        normal-background: transparent;
                        hover-background: root.dark-mode ? #202b3a : #eef6ff;
                        selected-background: root.dark-mode ? #188697 : #0f7c8c;
                        normal-text: root.text-body;
                        selected-text: #ffffff;
                        clicked => { root.selected-page = 1; }
                    }
                    NavItem {
                        label: "参数设置";
                        selected: root.selected-page == 0;
                        normal-background: transparent;
                        hover-background: root.dark-mode ? #202b3a : #eef6ff;
                        selected-background: root.dark-mode ? #188697 : #0f7c8c;
                        normal-text: root.text-body;
                        selected-text: #ffffff;
                        clicked => { root.selected-page = 0; }
                    }
                    NavItem {
                        label: "大图模式";
                        selected: root.selected-page == 2;
                        normal-background: transparent;
                        hover-background: root.dark-mode ? #202b3a : #eef6ff;
                        selected-background: root.dark-mode ? #188697 : #0f7c8c;
                        normal-text: root.text-body;
                        selected-text: #ffffff;
                        clicked => { root.selected-page = 2; }
                    }

                    Rectangle { vertical-stretch: 1; background: transparent; }

                    NavItem {
                        label: "设置";
                        selected: root.selected-page == 3;
                        normal-background: transparent;
                        hover-background: root.dark-mode ? #202b3a : #eef6ff;
                        selected-background: root.dark-mode ? #188697 : #0f7c8c;
                        normal-text: root.text-body;
                        selected-text: #ffffff;
                        clicked => { root.selected-page = 3; }
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                background: transparent;

                if root.selected-page == 0: ScrollView {
                    VerticalLayout {
                        padding-left: 4px;
                        padding-right: 4px;
                        spacing: 14px;

                        HorizontalLayout {
                            spacing: 14px;

                            Rectangle {
                                horizontal-stretch: 1;
                                min-height: 440px;
                                border-radius: 18px;
                                background: root.panel-bg;
                                border-color: root.panel-border;
                                border-width: 1px;
                                animate background, border-color { duration: 180ms; easing: ease-out; }

                                VerticalLayout {
                                    padding: 22px;
                                    spacing: 18px;

                                    HorizontalLayout {
                                        spacing: 22px;

                                        VerticalLayout {
                                            spacing: 18px;
                                            horizontal-stretch: 1;

                                            HorizontalLayout {
                                                spacing: 12px;
                                                Text { text: "后端"; width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                    height: 38px;
                                                    border-radius: 6px;
                                                    border-width: 1px;
                                                    border-color: root.field-border;
                                                    background: root.field-bg;
                                                    animate background, border-color { duration: 180ms; easing: ease-out; }
                                                    Text { x: 11px; width: parent.width - 22px; text: "原生 native"; color: root.text-body; font-size: 13px; vertical-alignment: center; overflow: elide; }
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: 12px;
                                                Text { text: "格式"; width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                                SoftComboBox { model: [{ text: "AVIF", enabled: true }, { text: "WebP", enabled: true }, { text: "JXL", enabled: true }]; current-index <=> root.format-index; enabled: !root.running; horizontal-stretch: 1; normal-background: root.combo-bg; hover-background: root.combo-bg-hover; disabled-background: root.combo-bg-disabled; selected-background: root.combo-selected-bg; normal-border: root.combo-border; hover-border: root.combo-border-hover; normal-text: root.text-body; disabled-text: root.text-soft; muted-text: root.text-muted; selected-text: root.accent-strong; }
                                            }

                                            HorizontalLayout {
                                                spacing: 12px;
                                                opacity: root.format-index == 0 ? 1.0 : 0.56;
                                                animate opacity { duration: 140ms; easing: ease-out; }
                                                Text { text: "编码器"; width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                                SoftComboBox { model: root.avif-encoder-options; current-index <=> root.avif-encoder-index; enabled: !root.running && root.format-index == 0; horizontal-stretch: 1; normal-background: root.combo-bg; hover-background: root.combo-bg-hover; disabled-background: root.combo-bg-disabled; selected-background: root.combo-selected-bg; normal-border: root.combo-border; hover-border: root.combo-border-hover; normal-text: root.text-body; disabled-text: root.text-soft; muted-text: root.text-muted; selected-text: root.accent-strong; }
                                            }

                                            HorizontalLayout {
                                                spacing: 12px;
                                                Text { text: "线程"; width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                                LineEdit { text <=> root.threads-text; placeholder-text: "自动/按需填线程数"; input-type: number; enabled: !root.running; horizontal-stretch: 1; height: 38px; }
                                            }

                                            HorizontalLayout {
                                                spacing: 12px;
                                                Text { text: "内存"; width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                                LineEdit { text <=> root.memory-limit-text; placeholder-text: "自动/按需填内存上限，单位是GiB"; enabled: !root.running; horizontal-stretch: 1; height: 38px; }
                                            }

                                            Rectangle {}
                                        }

                                        VerticalLayout {
                                            spacing: 18px;
                                            horizontal-stretch: 1;

                                            HorizontalLayout {
                                                spacing: 12px;
                                                Text { text: "质量"; width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                                LineEdit { text <=> root.quality-text; placeholder-text: root.visual-quality-text.is-empty ? "1-100" : "由视觉质量自动控制"; enabled: !root.running && root.visual-quality-text.is-empty; horizontal-stretch: 1; opacity: root.visual-quality-text.is-empty ? 1.0 : 0.56; animate opacity { duration: 140ms; easing: ease-out; } height: 38px; }
                                            }

                                            HorizontalLayout {
                                                spacing: 12px;
                                                Text { text: "视觉质量"; width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                                LineEdit { text <=> root.visual-quality-text; placeholder-text: "空由质量决定，1-100"; input-type: number; enabled: !root.running; horizontal-stretch: 1; height: 38px; }
                                            }

                                            HorizontalLayout {
                                                spacing: 12px;
                                                Text { text: "速度"; width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                                LineEdit { text <=> root.speed-text; placeholder-text: "默认/可选0-10"; enabled: !root.running; horizontal-stretch: 1; height: 38px; }
                                            }

                                            HorizontalLayout {
                                                spacing: 12px;
                                                opacity: root.format-index == 1 || root.format-index == 2 ? 0.56 : 1.0;
                                                animate opacity { duration: 140ms; easing: ease-out; }
                                                Text { text: "位深"; width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                                LineEdit { text <=> root.bit-depth-text; placeholder-text: root.format-index == 1 ? "8 bit" : (root.format-index == 2 ? "JXL 不支持手动位深" : "保持原片"); enabled: !root.running && root.format-index == 0; horizontal-stretch: 1; height: 38px; }
                                            }

                                            HorizontalLayout {
                                                spacing: 12px;
                                                opacity: root.format-index == 0 && root.avif-encoder-index != 1 ? 1.0 : 0.56;
                                                animate opacity { duration: 140ms; easing: ease-out; }
                                                Text { text: "色度采样"; width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                                SoftComboBox { model: [{ text: "auto", enabled: true }, { text: "444", enabled: true }, { text: "422", enabled: true }, { text: "420", enabled: true }]; current-index <=> root.chroma-index; enabled: !root.running && root.format-index == 0 && root.avif-encoder-index != 1; horizontal-stretch: 1; normal-background: root.combo-bg; hover-background: root.combo-bg-hover; disabled-background: root.combo-bg-disabled; selected-background: root.combo-selected-bg; normal-border: root.combo-border; hover-border: root.combo-border-hover; normal-text: root.text-body; disabled-text: root.text-soft; muted-text: root.text-muted; selected-text: root.accent-strong; }
                                            }

                                            HorizontalLayout {
                                                spacing: 12px;
                                                opacity: root.format-index == 0 ? 1.0 : 0.56;
                                                animate opacity { duration: 140ms; easing: ease-out; }
                                                Text { text: "透明通道"; width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                                SoftComboBox { model: [{ text: "强制开启", enabled: true }, { text: "自动", enabled: true }, { text: "关闭", enabled: true }]; current-index <=> root.alpha-policy-index; enabled: !root.running && root.format-index == 0; horizontal-stretch: 1; normal-background: root.combo-bg; hover-background: root.combo-bg-hover; disabled-background: root.combo-bg-disabled; selected-background: root.combo-selected-bg; normal-border: root.combo-border; hover-border: root.combo-border-hover; normal-text: root.text-body; disabled-text: root.text-soft; muted-text: root.text-muted; selected-text: root.accent-strong; }
                                            }
                                        }
                                    }

                                }
                            }                        }
                    }
                }

                if root.selected-page == 1: VerticalLayout {
                    spacing: 14px;
                    padding-left: 4px;
                    padding-right: 4px;

                    Rectangle {
                        border-radius: 18px;
                        background: root.panel-bg;
                        border-color: root.panel-border;
                        border-width: 1px;
                        animate background, border-color { duration: 180ms; easing: ease-out; }

                        VerticalLayout {
                            padding: 22px;
                            spacing: 14px;

                            VerticalLayout {
                                spacing: 18px;
                                horizontal-stretch: 1;

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "输入路径"; width: 78px; color: root.text-body; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                                    LineEdit { text <=> root.input-path; placeholder-text: "输入图片文件或文件夹路径"; enabled: !root.running; horizontal-stretch: 1; height: 38px; }
                                    SoftComboBox { model: [{ text: "文件", enabled: true }, { text: "文件夹", enabled: true }]; current-index <=> root.input-mode-index; enabled: !root.running; width: 100px; normal-background: root.combo-bg; hover-background: root.combo-bg-hover; disabled-background: root.combo-bg-disabled; selected-background: root.combo-selected-bg; normal-border: root.combo-border; hover-border: root.combo-border-hover; normal-text: root.text-body; disabled-text: root.text-soft; muted-text: root.text-muted; selected-text: root.accent-strong; }
                                    SoftButton { dark-mode: root.dark-mode; text: "选择"; width: 68px; height: 38px; enabled: !root.running; clicked => { root.browse-input(); } }
                                    SoftButton { dark-mode: root.dark-mode; text: "打开"; width: 68px; height: 38px; clicked => { root.open-input(); } }
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "输出目录"; width: 78px; color: root.text-body; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                                    LineEdit { text <=> root.output-dir; placeholder-text: "默认与输入同目录"; enabled: !root.running; horizontal-stretch: 1; height: 38px; }
                                    Rectangle { width: 100px; background: transparent; }
                                    SoftButton { dark-mode: root.dark-mode; text: "选择"; width: 68px; height: 38px; enabled: !root.running; clicked => { root.browse-output(); } }
                                    SoftButton { dark-mode: root.dark-mode; text: "打开"; width: 68px; height: 38px; clicked => { root.open-output(); } }
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "命名规则"; width: 78px; color: root.text-body; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                                    LineEdit { text <=> root.template-text; placeholder-text: "例：{name}_{date}"; enabled: !root.running; horizontal-stretch: 1; height: 38px; }
                                    Text { text: "重复处理"; width: 68px; color: root.text-body; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                                    SoftComboBox {
                                        model: [{ text: "覆盖", enabled: true }, { text: "跳过", enabled: true }, { text: "追加时间", enabled: true }, { text: "追加随机", enabled: true }];
                                        current-index <=> root.collision-index;
                                        enabled: !root.running;
                                        width: 178px;
                                        normal-background: root.combo-bg;
                                        hover-background: root.combo-bg-hover;
                                        disabled-background: root.combo-bg-disabled;
                                        selected-background: root.combo-selected-bg;
                                        normal-border: root.combo-border;
                                        hover-border: root.combo-border-hover;
                                        normal-text: root.text-body;
                                        disabled-text: root.text-soft;
                                        muted-text: root.text-muted;
                                        selected-text: root.accent-strong;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    Rectangle { width: 88px; background: transparent; }
                                    SoftButton { dark-mode: root.dark-mode; text: "参数"; width: 58px; height: 38px; enabled: !root.running; checked: root.template-params-selected; clicked => { root.toggle-template-token("{params}"); } }
                                    SoftButton { dark-mode: root.dark-mode; text: "日期"; width: 58px; height: 38px; enabled: !root.running; checked: root.template-date-selected; clicked => { root.toggle-template-token("{date}"); } }
                                    SoftButton { dark-mode: root.dark-mode; text: "时间"; width: 58px; height: 38px; enabled: !root.running; checked: root.template-time-selected; clicked => { root.toggle-template-token("{time}"); } }
                                    SoftButton { dark-mode: root.dark-mode; text: "随机"; width: 58px; height: 38px; enabled: !root.running; checked: root.template-rand-selected; clicked => { root.toggle-template-token("{rand}"); } }
                                    SoftButton { dark-mode: root.dark-mode; text: "哈希"; width: 58px; height: 38px; enabled: !root.running; checked: root.template-hash8-selected; clicked => { root.toggle-template-token("{hash8}"); } }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                }
                            }

                            HorizontalLayout {
                                spacing: 16px;
                                CheckBox { text: "生成 summary.csv"; checked <=> root.write-summary; enabled: !root.running; }
                                CheckBox { text: "写入日志"; checked <=> root.write-log; enabled: !root.running; }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                SoftButton { dark-mode: root.dark-mode; text: root.running ? "停止后重启" : "开始转换"; variant: "action"; height: 42px; enabled: true; horizontal-stretch: 1; clicked => { root.start-conversion(); } }
                                SoftButton { dark-mode: root.dark-mode; text: "取消"; variant: "danger"; height: 42px; enabled: root.running; horizontal-stretch: 1; clicked => { root.cancel-conversion(); } }
                                SoftButton { dark-mode: root.dark-mode; text: "清空"; height: 42px; enabled: !root.running; horizontal-stretch: 1; clicked => { root.clear-tasks(); } }
                                SoftButton { dark-mode: root.dark-mode; text: "打开输出目录"; height: 42px; horizontal-stretch: 1; clicked => { root.open-output(); } }
                            }
                        }
                    }

                    Rectangle {
                        border-radius: 18px;
                        background: root.panel-bg;
                        border-color: root.panel-border;
                        border-width: 1px;
                        vertical-stretch: 1;
                        animate background, border-color { duration: 180ms; easing: ease-out; }

                        VerticalLayout {
                            padding: 18px;
                            spacing: 10px;

                            Rectangle {
                                height: 32px;
                                border-radius: 9px;
                                background: root.field-bg;
                                border-color: root.field-border;
                                border-width: 1px;
                                animate background, border-color { duration: 180ms; easing: ease-out; }
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 10px;
                                    Text { text: "文件名"; width: 260px; color: root.text-muted; font-size: 12px; vertical-alignment: center; }
                                    Text { text: "格式"; width: 72px; color: root.text-muted; font-size: 12px; vertical-alignment: center; }
                                    Text { text: "状态"; horizontal-stretch: 1; color: root.text-muted; font-size: 12px; vertical-alignment: center; }
                                    Text { text: "日志"; width: 340px; color: root.text-muted; font-size: 12px; vertical-alignment: center; }
                                }
                            }

                            Rectangle {
                                vertical-stretch: 1;
                                border-radius: 12px;
                                background: root.dark-mode ? #151b25 : #ffffff;
                                border-color: root.panel-border;
                                border-width: 1px;
                                clip: true;
                                animate background, border-color { duration: 180ms; easing: ease-out; }

                                if root.task-rows.length == 0: Text {
                                    text: "暂无任务";
                                    color: root.text-muted;
                                    font-size: 13px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                if root.task-rows.length > 0: ListView {
                                     for row[index] in root.task-rows: Rectangle {
                                         background: index / 2 * 2 == index ? (root.dark-mode ? #1c2533 : #f4f8fe) : transparent;
                                         border-radius: 6px;
                                         height: 34px;
                                         HorizontalLayout {
                                             padding-left: 10px;
                                             padding-right: 10px;
                                             spacing: 10px;
                                             Text { text: row.filename; width: 260px; color: root.text-body; font-size: 12px; overflow: elide; vertical-alignment: center; }
                                             Text { text: row.format; width: 72px; color: root.text-muted; font-size: 12px; vertical-alignment: center; }
                                             Text { text: row.status; horizontal-stretch: 1; color: root.text-body; font-size: 12px; overflow: elide; vertical-alignment: center; }
                                             Text { text: row.log; width: 340px; color: root.text-muted; font-size: 12px; overflow: elide; vertical-alignment: center; }
                                         }
                                     }
                                 }
                            }

                            Rectangle {
                                height: 10px;
                                border-radius: 5px;
                                background: root.progress-track;
                                clip: true;
                                animate background { duration: 180ms; easing: ease-out; }
                                Rectangle {
                                    x: 0px;
                                    width: parent.width * root.progress;
                                    height: parent.height;
                                    border-radius: 5px;
                                    background: root.progress-fill;
                                    animate width, background { duration: 160ms; easing: ease-out; }
                                }
                            }

                            Text { text: "总进度：" + root.status-text; color: root.text-muted; font-size: 12px; }
                        }
                    }
                }

                if root.selected-page == 2: ScrollView {
                    VerticalLayout {
                        padding-left: 4px;
                        padding-right: 4px;
                        spacing: 14px;

                        Rectangle {
                            height: 120px;
                            border-radius: 18px;
                            background: root.chrome-bg;
                            border-color: root.panel-border;
                            border-width: 1px;
                            animate background, border-color { duration: 180ms; easing: ease-out; }
                            VerticalLayout {
                                padding: 24px;
                                spacing: 6px;
                                Text { text: "大图模式"; color: root.text-strong; font-size: 30px; font-weight: 800; }
                                Text { text: "超出普通 AVIF 硬编码队列限制的图片会进入这里，可选择 grid 或 zenrav1e 单独处理。"; color: root.text-muted; font-size: 14px; }
                            }
                        }

                        HorizontalLayout {
                            spacing: 14px;

                            Rectangle {
                                horizontal-stretch: 1;
                                min-height: 520px;
                                border-radius: 18px;
                                background: root.panel-bg;
                                border-color: root.panel-border;
                                border-width: 1px;
                                animate background, border-color { duration: 180ms; easing: ease-out; }
                                VerticalLayout {
                                    padding: 18px;
                                    spacing: 10px;
                                    Text { text: "大图队列"; color: root.text-strong; font-size: 18px; font-weight: 800; }
                                    Text { text: root.large-image-rows.length == 0 ? "暂无大图任务。开始 AVIF 转换后，>=30M 像素或任一边超过 65536 的图片会自动移入这里。" : "选择一项后使用右侧操作继续处理。"; color: root.text-muted; font-size: 13px; wrap: word-wrap; }

                                    Rectangle {
                                        height: 32px;
                                        border-radius: 9px;
                                        background: root.field-bg;
                                        border-color: root.field-border;
                                        border-width: 1px;
                                        animate background, border-color { duration: 180ms; easing: ease-out; }
                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 10px;
                                            Text { text: "文件名"; width: 240px; color: root.text-muted; font-size: 12px; vertical-alignment: center; }
                                            Text { text: "尺寸"; width: 150px; color: root.text-muted; font-size: 12px; vertical-alignment: center; }
                                            Text { text: "原因"; horizontal-stretch: 1; color: root.text-muted; font-size: 12px; vertical-alignment: center; }
                                            Text { text: "状态"; width: 170px; color: root.text-muted; font-size: 12px; vertical-alignment: center; }
                                        }
                                    }

                                    Rectangle {
                                        vertical-stretch: 1;
                                        border-radius: 12px;
                                        background: root.dark-mode ? #151b25 : #ffffff;
                                        border-color: root.panel-border;
                                        border-width: 1px;
                                        clip: true;
                                        animate background, border-color { duration: 180ms; easing: ease-out; }

                                        if root.large-image-rows.length == 0: Text {
                                            text: "暂无大图任务";
                                            color: root.text-muted;
                                            font-size: 13px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        if root.large-image-rows.length > 0: ListView {
                                            for row[index] in root.large-image-rows: Rectangle {
                                                background: index == root.selected-large-image-index ? root.accent-soft : (index / 2 * 2 == index ? (root.dark-mode ? #1c2533 : #f4f8fe) : transparent);
                                                border-radius: 6px;
                                                height: 40px;
                                                animate background { duration: 120ms; easing: ease-out; }
                                                HorizontalLayout {
                                                    padding-left: 10px;
                                                    padding-right: 10px;
                                                    spacing: 10px;
                                                    Text { text: row.filename; width: 240px; color: root.text-body; font-size: 12px; overflow: elide; vertical-alignment: center; }
                                                    Text { text: row.dimensions; width: 150px; color: root.text-muted; font-size: 12px; vertical-alignment: center; }
                                                    Text { text: row.reason; horizontal-stretch: 1; color: root.text-body; font-size: 12px; overflow: elide; vertical-alignment: center; }
                                                    Text { text: row.status; width: 170px; color: root.text-muted; font-size: 12px; overflow: elide; vertical-alignment: center; }
                                                }
                                                TouchArea { clicked => { root.selected-large-image-index = index; } }
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                width: 360px;
                                min-height: 520px;
                                border-radius: 18px;
                                background: root.panel-bg;
                                border-color: root.panel-border;
                                border-width: 1px;
                                animate background, border-color { duration: 180ms; easing: ease-out; }
                                VerticalLayout {
                                    padding: 22px;
                                    spacing: 14px;
                                    Text { text: "处理方式"; color: root.text-strong; font-size: 18px; font-weight: 800; }
                                    Text { text: root.selected-large-image-index >= 0 && root.selected-large-image-index < root.large-image-rows.length ? root.large-image-rows[root.selected-large-image-index].filename : "未选择大图任务"; color: root.text-body; font-size: 14px; font-weight: 700; overflow: elide; }
                                    Text { text: root.selected-large-image-index >= 0 && root.selected-large-image-index < root.large-image-rows.length ? root.large-image-rows[root.selected-large-image-index].dimensions : ""; color: root.text-muted; font-size: 13px; }
                                    Text { text: root.selected-large-image-index >= 0 && root.selected-large-image-index < root.large-image-rows.length ? root.large-image-rows[root.selected-large-image-index].actions : "请先在左侧选择一项。"; color: root.text-muted; font-size: 13px; wrap: word-wrap; }
                                    SoftButton { dark-mode: root.dark-mode; text: "使用 AVIF grid"; variant: "action"; height: 42px; enabled: !root.running && root.selected-large-image-index >= 0 && root.selected-large-image-index < root.large-image-rows.length; clicked => { root.large-image-action-requested(root.selected-large-image-index, "grid"); } }
                                    SoftButton { dark-mode: root.dark-mode; text: "使用 zenrav1e"; height: 42px; enabled: !root.running && root.selected-large-image-index >= 0 && root.selected-large-image-index < root.large-image-rows.length; clicked => { root.large-image-action-requested(root.selected-large-image-index, "zenrav1e"); } }

                                    Rectangle {
                                        border-radius: 12px;
                                        background: root.panel-bg-soft;
                                        border-color: root.field-border;
                                        border-width: 1px;
                                        animate background, border-color { duration: 180ms; easing: ease-out; }
                                        VerticalLayout {
                                            padding: 14px;
                                            spacing: 8px;
                                            Text { text: "规则"; color: root.text-strong; font-size: 15px; font-weight: 800; }
                                            Text { text: "• grid 使用 libavif + AOM 的 AVIF grid，不是 AV1 tile。"; color: root.text-body; font-size: 13px; wrap: word-wrap; }
                                            Text { text: "• zenrav1e 仅生成单图 AVIF，不支持 grid，边长必须 <= 65536。"; color: root.text-body; font-size: 13px; wrap: word-wrap; }
                                            Text { text: "• 自动 grid 默认 16384 x 8704 tile，优先寻找可整除分块；若必须 padding，当前会拒绝编码以避免输出尺寸扩大。"; color: root.text-body; font-size: 13px; wrap: word-wrap; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.selected-page == 3: ScrollView {
                    VerticalLayout {
                        padding-left: 4px;
                        padding-right: 4px;
                        spacing: 20px;

                        Rectangle {
                            height: 120px;
                            border-radius: 18px;
                            background: root.chrome-bg;
                            border-color: root.panel-border;
                            border-width: 1px;
                            animate background, border-color { duration: 180ms; easing: ease-out; }
                            VerticalLayout {
                                padding: 24px;
                                spacing: 6px;
                                Text { text: "设置"; color: root.text-strong; font-size: 30px; font-weight: 800; }
                            }
                        }

                        Rectangle {
                            border-radius: 18px;
                            background: root.panel-bg;
                            border-color: root.panel-border;
                            border-width: 1px;
                            animate background, border-color { duration: 180ms; easing: ease-out; }
                            VerticalLayout {
                                padding: 24px;
                                spacing: 18px;
                                Text { text: "外观"; color: root.text-strong; font-size: 18px; font-weight: 800; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    Text { text: "主题"; width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                    SoftComboBox { model: [{ text: "跟随系统", enabled: true }, { text: "浅色", enabled: true }, { text: "深色", enabled: true }]; current-index <=> root.theme-index; width: 250px; normal-background: root.combo-bg; hover-background: root.combo-bg-hover; disabled-background: root.combo-bg-disabled; selected-background: root.combo-selected-bg; normal-border: root.combo-border; hover-border: root.combo-border-hover; normal-text: root.text-body; disabled-text: root.text-soft; muted-text: root.text-muted; selected-text: root.accent-strong; }
                                    Rectangle { background: transparent; }
                                }
                            }
                        }

                        Rectangle {
                            border-radius: 18px;
                            background: root.panel-bg;
                            border-color: root.panel-border;
                            border-width: 1px;
                            animate background, border-color { duration: 180ms; easing: ease-out; }
                            VerticalLayout {
                                padding: 24px;
                                spacing: 20px;
                                Text { text: "高级与实验功能"; color: root.text-strong; font-size: 18px; font-weight: 800; }
                                VerticalLayout {
                                    spacing: 8px;
                                    CheckBox { text: "允许 WIC 兜底"; checked <=> root.allow-wic-fallback; enabled: !root.running; }
                                    Text { text: "开启后，若内置的专业级 Native 解码器（如 libavif, libwebp）加载图片失败，系统将自动尝试使用 Windows WIC（Windows Imaging Component）作为兜底解码路径。"; color: root.text-muted; font-size: 13px; wrap: word-wrap; }
                                }
                                VerticalLayout {
                                    spacing: 8px;
                                    CheckBox { text: "启用实验性编码器（zenrav1e）"; checked <=> root.experimental-encoders; enabled: !root.running; }
                                    Text { text: "启用后，构建支持时可显式选择 zenrav1e；auto 仅在大图 opaque 420 <=10-bit fallback 路径中使用它。不可用时选项会置灰。"; color: root.text-muted; font-size: 13px; wrap: word-wrap; }
                                }
                            }
                        }

                        Rectangle {
                            border-radius: 18px;
                            background: root.panel-bg;
                            border-color: root.panel-border;
                            border-width: 1px;
                            animate background, border-color { duration: 180ms; easing: ease-out; }
                            VerticalLayout {
                                padding: 24px;
                                spacing: 14px;
                                Text { text: "关于后端"; color: root.text-strong; font-size: 18px; font-weight: 800; }
                                Text { text: "当前内置后端：native codec"; color: root.text-body; font-size: 14px; }
                                Text { text: "支持：libavif / AOM、svt-av1-hdr、实验 zenrav1e、WebP、JXL。"; color: root.text-body; font-size: 14px; }
                                Text { text: "外部后端设置已移除，编码流程统一走 native。"; color: root.text-muted; font-size: 13px; }
                            }
                        }

                        Rectangle { height: 10px; background: transparent; }
                    }
                }
            }
        }
    }
}
