import { Button, CheckBox, LineEdit, Palette, ScrollView, ListView } from "std-widgets.slint";

export struct TaskRow {
    order: string,
    filename: string,
    folder: string,
    size: string,
    status: string,
    output: string,
    log: string,
    warning: bool,
    locked: bool,
}

export struct LargeImageRow {
    filename: string,
    dimensions: string,
    reason: string,
    actions: string,
    status: string,
    grid-available: bool,
    zenrav1e-available: bool,
}

export struct ComboOption {
    text: string,
    enabled: bool,
}

component SoftComboBox inherits Rectangle {
    in property <[ComboOption]> model;
    in-out property <int> current-index;
    in property <bool> enabled: true;
    out property <bool> has-hover <=> touch.has-hover;
    in property <color> normal-background: #fbfdff;
    in property <color> hover-background: #f3f8ff;
    in property <color> disabled-background: #eef2f7;
    in property <color> selected-background: #e7f1ff;
    in property <color> normal-border: #dfe8f3;
    in property <color> hover-border: #b9d6f7;
    in property <color> normal-text: #334155;
    in property <color> disabled-text: #94a3b8;
    in property <color> muted-text: #64748b;
    in property <color> selected-text: #0b5ed7;
    in property <int> close-generation: 0;
    in property <bool> defer-current-index: false;
    in property <bool> center-text: false;
    in property <length> viewport-height: 100000px;
    in property <int> max-visible-items: 0;
    property <length> popup-gap: 8px;
    property <int> popup-visible-items: root.max-visible-items > 0
        ? min(max(root.model.length, 1), root.max-visible-items)
        : max(root.model.length, 1);
    property <length> popup-content-height: max(root.model.length, 1) * 36px + 8px;
    property <length> popup-height: root.popup-visible-items * 36px + 8px;
    property <length> popup-scroll-y: -max(0, min(root.current-index, root.model.length - root.popup-visible-items)) * 36px;
    property <bool> popup-upwards: touch.absolute-position.y + root.height + root.popup-gap + root.popup-height > root.viewport-height && touch.absolute-position.y >= root.popup-height + root.popup-gap;
    property <bool> popup-open: false;
    property <bool> popup-opening: false;
    property <bool> popup-animate-open: false;
    property <bool> popup-had-focus: false;
    property <int> hover-index: -1;
    property <int> highlight-index: root.hover-index >= 0 ? root.hover-index : root.current-index;
    property <int> bounded-highlight-index: max(0, min(root.highlight-index, max(root.model.length - 1, 0)));
    callback selection-accepted(int, length, length);
    callback popup-requested();
    callback popup-finished();

    open-animation-timer := Timer {
        interval: 50ms;
        running: root.popup-opening;
        triggered => {
            root.popup-animate-open = true;
            root.popup-opening = false;
        }
    }

    min-width: 128px;
    min-height: 38px;

    horizontal-stretch: 1;
    vertical-stretch: 0;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.has-hover ? root.hover-border : root.normal-border;
    background: root.enabled ? (root.has-hover ? root.hover-background : root.normal-background) : root.disabled-background;
    clip: true;
    animate background, border-color { duration: 150ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        spacing: 8px;
        Text {
            text: root.model[root.current-index].text;
            color: root.enabled ? root.normal-text : root.disabled-text;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-alignment: root.center-text ? center : left;
            horizontal-stretch: 1;
            overflow: elide;
            opacity: root.center-text ? 0.0 : 1.0;
            animate color { duration: 150ms; easing: ease-out; }
        }
        Rectangle {
            width: 14px;
            height: 14px;
            y: (parent.height - 14px) / 2;
            Text {
                text: root.popup-open ? "▲" : "▼";
                color: root.muted-text;
                font-size: 10px;
                font-weight: 700;
                width: 14px;
                height: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
                y: root.popup-open ? 1px : 0px;
                animate y { duration: 120ms; easing: ease-out; }
            }
        }
    }

    if root.center-text: Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        text: root.model[root.current-index].text;
        color: root.enabled ? root.normal-text : root.disabled-text;
        font-size: 13px;
        vertical-alignment: center;
        horizontal-alignment: center;
        overflow: elide;
        animate color { duration: 150ms; easing: ease-out; }
    }

    touch := TouchArea {
        clicked => {
            if (root.enabled) {
                root.hover-index = -1;
                root.popup-opening = false;
                root.popup-open = true;
                root.popup-animate-open = false;
                popup.show();
                root.popup-opening = true;
            }
        }
    }

    changed close-generation => {
        if (root.popup-open) {
            root.popup-finished();
        }
        root.popup-open = false;
        root.popup-opening = false;
        root.popup-animate-open = false;
        root.popup-had-focus = false;
        root.hover-index = -1;
        popup.close();
    }

    popup := PopupWindow {
        x: 0px;
        y: root.popup-upwards ? -root.popup-height - root.popup-gap : root.height + root.popup-gap;
        width: root.width;
        height: root.popup-height;
        close-policy: close-on-click-outside;
        forward-focus: popup-focus;

        popup-focus := FocusScope {
            width: parent.width;
            height: parent.height;
            init => {
                self.focus();
                root.popup-had-focus = true;
                root.popup-open = true;
            }
            focus-changed-event => {
                if (self.has-focus) {
                    root.popup-had-focus = true;
                    root.popup-open = true;
                } else if (root.popup-had-focus && root.popup-open) {
                    root.popup-open = false;
                    root.popup-opening = false;
                    root.popup-animate-open = false;
                    root.popup-had-focus = false;
                    root.hover-index = -1;
                    root.popup-finished();
                }
            }

            popup-container := Rectangle {
                width: parent.width;
                height: root.popup-animate-open ? parent.height : 0px;
                y: root.popup-upwards ? parent.height - popup-container.height : 0px;
                animate height { duration: 260ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }

                border-radius: 8px;
                border-width: 1px;
                border-color: root.normal-border;
                background: root.normal-background;
                clip: true;

                popup-list := ScrollView {
                    width: parent.width;
                    height: parent.height;
                    viewport-width: self.width;
                    viewport-height: root.popup-content-height;
                    viewport-y: root.popup-scroll-y;

                    Rectangle {
                        width: popup-list.width;
                        height: root.popup-content-height;
                        background: transparent;

                        Rectangle {
                            x: 4px;
                            y: 4px + root.bounded-highlight-index * 36px;
                            width: parent.width - 8px;
                            height: 36px;
                            border-radius: 6px;
                            background: root.model[root.bounded-highlight-index].enabled ? (root.bounded-highlight-index == root.current-index ? root.selected-background : root.hover-background) : transparent;
                            animate y, background { duration: 180ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }
                        }

                        VerticalLayout {
                            padding: 4px;
                            for option[index] in root.model: Rectangle {
                                height: 36px;
                                border-radius: 6px;
                                background: transparent;

                                Text {
                                    x: 10px;
                                    width: parent.width - 20px;
                                    text: option.text;
                                    color: !option.enabled ? root.disabled-text : (index == root.current-index ? root.selected-text : root.normal-text);
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                item-touch := TouchArea {
                                    changed has-hover => {
                                        if (item-touch.has-hover && option.enabled) {
                                            root.hover-index = index;
                                        } else if (root.hover-index == index) {
                                            root.hover-index = -1;
                                        }
                                    }
                                    clicked => {
                                        if (option.enabled) {
                                            root.selection-accepted(index, item-touch.absolute-position.x + item-touch.mouse-x, item-touch.absolute-position.y + item-touch.mouse-y);
                                            if (!root.defer-current-index) {
                                                root.current-index = index;
                                            }
                                            root.popup-open = false;
                                            root.popup-opening = false;
                                            root.popup-animate-open = false;
                                            root.popup-had-focus = false;
                                            root.hover-index = -1;
                                            root.popup-finished();
                                            popup.close();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

component SoftButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> checked: false;
    in property <string> variant: "outline"; // "outline" | "primary" | "danger" | "action"
    in property <bool> dark-mode: false;

    property <color> combo-bg: root.dark-mode ? #222c3b : #fbfdff;
    property <color> combo-bg-hover: root.dark-mode ? #293548 : #f3f8ff;
    property <color> combo-bg-disabled: root.dark-mode ? #1d2532 : #eef2f7;
    property <color> combo-selected-bg: root.dark-mode ? #14325b : #e7f1ff;
    property <color> combo-border: root.dark-mode ? #3a4658 : #dfe8f3;
    property <color> combo-border-hover: root.dark-mode ? #4d6684 : #b9d6f7;
    property <color> text-body: root.dark-mode ? #dce5f1 : #334155;
    property <color> text-soft: root.dark-mode ? #748299 : #94a3b8;
    property <color> accent-strong: root.dark-mode ? #5aa2ff : #0d6efd;

    out property <bool> has-hover <=> touch.has-hover;
    out property <bool> pressed <=> touch.pressed;
    callback clicked();

    min-height: 32px;
    vertical-stretch: 0;
    border-radius: 6px;
    border-width: root.variant == "outline" ? 1px : 0px;
    border-color: root.enabled ? (root.has-hover ? root.combo-border-hover : root.combo-border) : root.combo-border;

    background: !root.enabled ?
        root.combo-bg-disabled :
        (root.variant == "primary" ?
            (root.has-hover ? #0b5ed7 : #0d6efd) :
            (root.variant == "danger" ?
                (root.has-hover ? #b91c1c : #dc2626) :
                (root.variant == "action" ?
                    (root.has-hover ? #0a707e : #0f7c8c) :
                    (root.checked ?
                        root.combo-selected-bg :
                        (root.has-hover ? root.combo-bg-hover : root.combo-bg)
                    )
                )
            )
        );

    animate background, border-color, border-radius { duration: 150ms; easing: ease-out; }

    Rectangle {
        x: 0px;
        y: root.pressed ? 1.5px : 0px;
        width: parent.width;
        height: parent.height;
        animate y { duration: 60ms; easing: ease-out; }

        Text {
            x: 8px;
            width: parent.width - 16px;
            text: root.text;
            color: !root.enabled ? root.text-soft : (root.checked ? root.accent-strong : (root.variant == "primary" || root.variant == "danger" || root.variant == "action" ? #ffffff : root.text-body));
            font-size: 13px;
            font-weight: root.variant == "primary" || root.variant == "action" || root.variant == "danger" || root.checked ? 700 : 500;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
            animate color { duration: 150ms; easing: ease-out; }
        }
    }

    touch := TouchArea {
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <brush> normal-background: transparent;
    in property <brush> hover-background: #eef6ff;
    in property <brush> selected-background: #0f7c8c;
    in property <color> normal-text: #334155;
    in property <color> selected-text: #ffffff;
    out property <bool> has-hover <=> touch.has-hover;
    callback clicked();

    height: 46px;
    border-radius: 6px;
    background: root.selected ? root.selected-background : (root.has-hover ? root.hover-background : root.normal-background);
    animate background { duration: 150ms; easing: ease-out; }

    // Dynamic vertical stripe on the left edge
    Rectangle {
        x: 8px;
        y: (parent.height - (root.selected ? 20px : 0px)) / 2;
        width: 4px;
        height: root.selected ? 20px : 0px;
        border-radius: 2px;
        background: #ffffff;
        animate height, y { duration: 180ms; easing: ease-out; }
    }

    Text {
        text: root.label;
        color: root.selected ? root.selected-text : root.normal-text;
        font-size: 16px;
        font-weight: 700;
        x: (parent.width - self.width) / 2 + (root.selected ? 6px : (root.has-hover ? 4px : 0px));
        vertical-alignment: center;
        animate x, color { duration: 150ms; easing: ease-out; }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component QueueMenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    in property <bool> dark-mode: false;
    callback clicked();

    height: 38px;
    border-radius: 6px;
    background: root.enabled && touch.has-hover ? (root.dark-mode ? #243248 : #e7f1ff) : transparent;
    animate background { duration: 120ms; easing: ease-out; }

    Text {
        x: 10px;
        width: parent.width - 20px;
        text: root.text;
        color: !root.enabled ? (root.dark-mode ? #657186 : #94a3b8) : (root.danger ? (root.dark-mode ? #fb7185 : #dc2626) : (root.dark-mode ? #dce5f1 : #334155));
        font-size: 13px;
        font-weight: root.danger ? 700 : 500;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}


export component AwjStudio inherits Window {
    title: "AWJ Studio";
    icon: @image-url("logo.png");
    default-font-family: root.ui-font-family;
    preferred-width: 1220px;
    preferred-height: 800px;
    min-width: 820px;
    min-height: 560px;

    in-out property <string> input-path: "";
    in-out property <int> input-mode-index: 0;
    in-out property <string> output-dir: "";
    in-out property <int> format-index: 0;
    in-out property <int> preset-index: 0;
    in-out property <int> avif-encoder-index: 0;
    in property <[ComboOption]> avif-encoder-options: [{ text: "自动", enabled: true }, { text: "svt-av1-hdr", enabled: true }, { text: "aom", enabled: true }, { text: "zenrav1e", enabled: false }];
    in-out property <bool> experimental-encoders: true;
    in-out property <string> avif-quality-default: "";
    in-out property <string> webp-quality-default: "";
    in-out property <string> jxl-quality-default: "";
    in-out property <string> jpegli-quality-default: "";
    in-out property <string> webp-bit-depth-default: "";
    in-out property <string> quality-text: "80";
    in-out property <string> visual-quality-text: "";
    in-out property <bool> visual-quality-gpu: true;
    in-out property <string> visual-quality-gpu-help-text: "默认启用 Direct3D 11 加速 visual_quality 的 luma、GMSD 与 MS-SSIM 指标；codec 编码/解码仍使用 native CPU 库，失败或小图会自动回退 CPU。";
    in-out property <bool> visual-quality-fallback: false;
    in-out property <bool> allow-wic-fallback: true;
    in-out property <bool> wic-ui-visible: true;
    in-out property <bool> quality-follows-format: true;
    in-out property <string> bit-depth-text: "";
    in-out property <bool> bit-depth-follows-format: true;
    in-out property <int> chroma-index: 0;
    in-out property <int> jpegli-progressive-index: 2;
    in-out property <bool> jpegli-optimize-huffman: true;
    in-out property <bool> jpegli-xyb: false;
    in-out property <int> alpha-policy-index: 1;
    in-out property <string> threads-text: "";
    in-out property <string> memory-limit-text: "";
    in-out property <bool> unlock-max-input-file-bytes: false;
    in-out property <int> size-limit-index: 0;
    in-out property <string> max-width-text: "";
    in-out property <string> max-height-text: "";
    in-out property <string> max-long-edge-text: "";
    in-out property <string> max-short-edge-text: "";
    in-out property <string> speed-text: "";
    in-out property <string> template-text: "";
    in-out property <bool> template-params-selected: false;
    in-out property <bool> template-date-selected: false;
    in-out property <bool> template-time-selected: false;
    in-out property <bool> template-rand-selected: false;
    in-out property <bool> template-hash8-selected: false;
    in-out property <bool> template-sha2568-selected: false;
    in-out property <int> collision-index: 0;
    in-out property <int> theme-index: 0;
    in-out property <string> ui-font-family: "";
    in property <[ComboOption]> ui-font-options: [{ text: "系统默认字体", enabled: true }];
    in-out property <int> ui-font-index: 0;
    in-out property <bool> system-dark-mode: false;
    in-out property <bool> strip-metadata: false;
    in-out property <bool> write-summary: false;
    in-out property <bool> write-log: false;
    in-out property <string> context-menu-status: "";
    in-out property <string> context-menu-warning: "";
    in-out property <int> menu-format-index: 0;
    in-out property <int> menu-preset-index: 0;
    in-out property <string> menu-quality-text: "";
    in-out property <string> menu-bit-depth-text: "";
    in-out property <string> menu-speed-text: "";
    in-out property <int> menu-avif-encoder-index: 0;
    in-out property <int> menu-chroma-index: 0;
    in-out property <int> menu-alpha-policy-index: 1;
    in-out property <int> menu-jpegli-progressive-index: 2;
    in-out property <bool> menu-jpegli-optimize-huffman: true;
    in-out property <bool> menu-jpegli-xyb: false;
    in-out property <bool> menu-strip-metadata: false;
    in-out property <bool> menu-allow-wic-fallback: true;
    in-out property <bool> menu-close-on-finish: true;
    in-out property <int> menu-size-limit-index: 0;
    in-out property <string> menu-max-width-text: "";
    in-out property <string> menu-max-height-text: "";
    in-out property <string> menu-max-long-edge-text: "";
    in-out property <string> menu-max-short-edge-text: "";
    in-out property <bool> running: false;
    in-out property <bool> force-terminate-supported: true;
    in-out property <float> progress: 0.0;
    in-out property <string> status-text: "就绪";
    in property <[TaskRow]> task-rows;
    in property <[LargeImageRow]> large-image-rows;
    in-out property <int> selected-large-image-index: -1;
    in-out property <int> selected-large-image-action-index: 0;
    in-out property <int> queue-menu-index: -1;
    in-out property <length> queue-menu-x: 0px;
    in-out property <length> queue-menu-y: 0px;
    in-out property <length> queue-menu-origin-x: 0px;
    in-out property <length> queue-menu-origin-y: 0px;
    property <length> queue-menu-width: 216px;
    property <length> queue-menu-height: 338px;
    property <length> parameter-control-width: 210px;
    property <length> parameter-control-height: 38px;
    property <length> control-button-width: 86px;
    property <length> control-button-height: 38px;
    property <length> page-gap: 10px;
    property <length> nav-width: 196px;
    property <length> queue-filename-width: 170px;
    property <length> queue-size-width: 72px;
    property <length> queue-status-width: 104px;
    in-out property <int> pending-theme-index: -1;
    in-out property <int> combo-close-generation: 0;
    in-out property <bool> combo-popup-open: false;
    in-out property <bool> queue-menu-visible: false;
    in-out property <bool> queue-menu-opening: false;

    in-out property <int> selected-page: 1;
    property <int> chroma-index-before-forced: 0;
    property <bool> chroma-forced-by-avif-encoder: false;
    property <bool> dark-mode: root.theme-index == 2 || (root.theme-index == 0 && root.system-dark-mode);
    property <bool> pending-theme-dark-mode: root.pending-theme-index == 2 || (root.pending-theme-index == 0 && root.system-dark-mode);
    property <color> pending-theme-page-bg: root.pending-theme-dark-mode ? #10151e : #f3f7fd;
    property <color> page-bg: root.dark-mode ? #10151e : #f3f7fd;
    property <color> mica-tint: root.dark-mode ? #151c28 : #edf4ff;
    property <color> nav-bg: root.dark-mode ? #141b25 : #f8fbff;
    property <color> chrome-bg: root.dark-mode ? #18202c : #ffffff;
    property <color> panel-bg: root.dark-mode ? #1b2330 : #ffffff;
    property <color> panel-bg-soft: root.dark-mode ? #202a39 : #f8fbff;
    property <color> panel-border: root.dark-mode ? #303b4c : #dde7f3;
    property <color> field-bg: root.dark-mode ? #222c3b : #fbfdff;
    property <color> field-border: root.dark-mode ? #3a4658 : #e2eaf4;
    property <color> text-strong: root.dark-mode ? #f5f8fc : #111827;
    property <color> text-body: root.dark-mode ? #dce5f1 : #334155;
    property <color> text-muted: root.dark-mode ? #a0aec2 : #64748b;
    property <color> text-soft: root.dark-mode ? #748299 : #94a3b8;
    property <color> accent: #0d6efd;
    property <color> accent-strong: root.dark-mode ? #5aa2ff : #0b5ed7;
    property <color> accent-soft: root.dark-mode ? #14325b : #e7f1ff;
    property <color> success: #22b84c;
    property <color> success-soft: root.dark-mode ? #143522 : #eaf8ef;
    property <color> warning: #d97706;
    property <color> progress-track: root.dark-mode ? #293445 : #dbe7f5;
    property <brush> progress-fill: root.running ? #0d6efd : #22b84c;
    property <bool> queue-menu-valid: root.queue-menu-index >= 0 && root.queue-menu-index < root.task-rows.length;
    property <bool> queue-menu-editable: root.queue-menu-valid && !root.task-rows[root.queue-menu-index].locked;
    property <bool> queue-menu-removable: root.queue-menu-valid && !root.running;

    property <color> combo-bg: root.dark-mode ? #222c3b : #fbfdff;
    property <color> combo-bg-hover: root.dark-mode ? #293548 : #f3f8ff;
    property <color> combo-bg-disabled: root.dark-mode ? #1d2532 : #eef2f7;
    property <color> combo-selected-bg: root.dark-mode ? #14325b : #e7f1ff;
    property <color> combo-border: root.dark-mode ? #3a4658 : #dfe8f3;
    property <color> combo-border-hover: root.dark-mode ? #4d6684 : #b9d6f7;

    callback browse-input();
    callback input-path-accepted(string);
    callback browse-output();
    callback open-output();
    callback start-conversion();
    callback cancel-conversion();
    callback clear-tasks();
    callback queue-row-pointer-event(int, int, int, float);
    pure callback queue-drag-data(int) -> data-transfer;
    callback queue-drag-can-drop(DropEvent, int) -> DragAction;
    callback queue-drag-dropped(DropEvent, int) -> DragAction;
    callback queue-menu-action(int, string);
    callback combo-popup-requested();
    callback combo-popup-finished();
    callback theme-selection-requested(int, length, length);
    callback browse-large-image-file();
    callback browse-large-image-folder();
    callback large-image-action-requested(int, string);
    callback format-defaults-requested(int);
    callback preset-defaults-requested(int);
    callback install-context-menu-requested();
    callback remove-context-menu-requested();
    callback save-menu-params-requested();
    callback menu-format-selected(int);
    callback menu-preset-defaults-requested(int);
    callback context-menu-warning-clicked();
    callback toggle-template-token(string);
    callback title-bar-theme-requested(bool);

    init => {
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
        root.title-bar-theme-requested(root.dark-mode);
    }

    changed dark-mode => {
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
        root.title-bar-theme-requested(root.dark-mode);
    }

    changed format-index => {
        root.format-defaults-requested(root.format-index);
        if (!(root.format-index == 0 && root.avif-encoder-index == 1) && root.chroma-forced-by-avif-encoder) {
            root.chroma-index = root.chroma-index-before-forced;
            root.chroma-forced-by-avif-encoder = false;
        }
        if (root.format-index == 0 && root.avif-encoder-index == 1 && !root.chroma-forced-by-avif-encoder) {
            root.chroma-index-before-forced = root.chroma-index;
            root.chroma-index = 3;
            root.chroma-forced-by-avif-encoder = true;
        }
    }

    changed experimental-encoders => {
        root.format-defaults-requested(root.format-index);
    }

    changed jpegli-progressive-index => {
        if (root.jpegli-progressive-index > 0) {
            root.jpegli-optimize-huffman = true;
        }
    }

    changed preset-index => {
        root.preset-defaults-requested(root.preset-index);
    }

    changed menu-format-index => {
        root.menu-format-selected(root.menu-format-index);
    }

    changed menu-preset-index => {
        root.menu-preset-defaults-requested(root.menu-preset-index);
    }

    changed ui-font-index => {
        root.ui-font-family = root.ui-font-index > 0 && root.ui-font-index < root.ui-font-options.length
            ? root.ui-font-options[root.ui-font-index].text
            : "";
    }

    changed avif-encoder-index => {
        if (root.format-index == 0 && root.avif-encoder-index == 1) {
            if (!root.chroma-forced-by-avif-encoder) {
                root.chroma-index-before-forced = root.chroma-index;
                root.chroma-forced-by-avif-encoder = true;
            }
            root.chroma-index = 3;
        } else if (root.chroma-forced-by-avif-encoder) {
            root.chroma-index = root.chroma-index-before-forced;
            root.chroma-forced-by-avif-encoder = false;
        }
    }

    changed quality-text => {
        root.quality-follows-format =
            (root.format-index == 0 && root.quality-text == root.avif-quality-default)
            || (root.format-index == 1 && root.quality-text == root.webp-quality-default)
            || (root.format-index == 2 && root.quality-text == root.jxl-quality-default)
            || (root.format-index == 3 && root.quality-text == root.jpegli-quality-default);
    }

    changed bit-depth-text => {
        root.bit-depth-follows-format = (root.format-index == 1 || root.format-index == 3) ? root.bit-depth-text == root.webp-bit-depth-default : root.bit-depth-text.is-empty;
    }

    combo-popup-requested => {
        root.combo-close-generation = root.combo-close-generation + 1;
        root.combo-popup-open = true;
    }

    combo-popup-finished => {
        root.combo-popup-open = false;
    }

    theme-selection-requested(index, click-x, click-y) => {
        if (index != root.theme-index) {
            root.theme-index = index;
            root.pending-theme-index = -1;
        }
    }

    background: root.page-bg;

    Rectangle {
        background: root.page-bg;
        clip: true;
        animate background { duration: 180ms; easing: ease-out; }

        Rectangle {
            x: 0px;
            y: 0px;
            width: root.nav-width;
            height: parent.height;
            background: root.nav-bg;
            animate background { duration: 180ms; easing: ease-out; }
        }

        Rectangle {
            x: root.nav-width;
            y: 0px;
            width: 1px;
            height: parent.height;
            background: root.panel-border;
            animate background { duration: 180ms; easing: ease-out; }
        }

        Rectangle {
            x: root.nav-width + root.page-gap;
            y: root.page-gap;
            width: parent.width - root.nav-width - root.page-gap * 2;
            height: parent.height - root.page-gap * 2;
            border-radius: 8px;
            background: root.mica-tint;
            opacity: 0.56;
            animate background { duration: 180ms; easing: ease-out; }
        }

        HorizontalLayout {
            padding-top: root.page-gap;
            padding-bottom: root.page-gap;
            padding-right: root.page-gap;
            spacing: root.page-gap;

            Rectangle {
                width: root.nav-width;
                background: transparent;

                VerticalLayout {
                    padding: root.page-gap;
                    spacing: 10px;

                    Rectangle {
                        height: 52px;
                        background: transparent;
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "AWJ Studio"; color: root.text-strong; font-size: 24px; font-weight: 900; letter-spacing: 0px; }
                            Rectangle {
                                width: 56px;
                                height: 3px;
                                border-radius: 1.5px;
                                background: #0f7c8c;
                            }
                        }
                    }

                    Rectangle { height: 8px; background: transparent; }

                    NavItem {
                        label: "编码队列";
                        selected: root.selected-page == 1;
                        normal-background: transparent;
                        hover-background: root.dark-mode ? #202b3a : #eef6ff;
                        selected-background: root.dark-mode ? #188697 : #0f7c8c;
                        normal-text: root.text-body;
                        selected-text: #ffffff;
                        clicked => { root.selected-page = 1; }
                    }
                    NavItem {
                        label: "参数设置";
                        selected: root.selected-page == 0;
                        normal-background: transparent;
                        hover-background: root.dark-mode ? #202b3a : #eef6ff;
                        selected-background: root.dark-mode ? #188697 : #0f7c8c;
                        normal-text: root.text-body;
                        selected-text: #ffffff;
                        clicked => { root.selected-page = 0; }
                    }
                    NavItem {
                        label: "菜单参数";
                        selected: root.selected-page == 3;
                        normal-background: transparent;
                        hover-background: root.dark-mode ? #202b3a : #eef6ff;
                        selected-background: root.dark-mode ? #188697 : #0f7c8c;
                        normal-text: root.text-body;
                        selected-text: #ffffff;
                        clicked => { root.selected-page = 3; }
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }

                    NavItem {
                        label: "设置";
                        selected: root.selected-page == 2;
                        normal-background: transparent;
                        hover-background: root.dark-mode ? #202b3a : #eef6ff;
                        selected-background: root.dark-mode ? #188697 : #0f7c8c;
                        normal-text: root.text-body;
                        selected-text: #ffffff;
                        clicked => { root.selected-page = 2; }
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                background: transparent;

                if root.selected-page == 0: Rectangle {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    background: transparent;

                    Rectangle {
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        border-radius: 8px;
                        background: root.panel-bg;
                        border-color: root.panel-border;
                        border-width: 1px;
                        animate background, border-color { duration: 180ms; easing: ease-out; }

                        ScrollView {
                            horizontal-stretch: 1;
                            vertical-stretch: 1;
                            viewport-width: parent.width;
                            VerticalLayout {
                                padding: 22px;
                                spacing: 10px;
                                    VerticalLayout {
                                        spacing: 10px;

                                        HorizontalLayout {
                                            height: 48px;
                                            spacing: 10px;
                                            Text { text: "预设"; width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                            SoftComboBox { viewport-height: root.height; close-generation: root.combo-close-generation; popup-requested => { root.combo-popup-requested(); } popup-finished => { root.combo-popup-finished(); } model: [{ text: "自定义", enabled: true }, { text: "无损", enabled: true }, { text: "视觉无损", enabled: true }, { text: "平衡", enabled: true }, { text: "快速", enabled: true }, { text: "急速", enabled: true }]; current-index <=> root.preset-index; enabled: !root.running; width: root.parameter-control-width; height: root.parameter-control-height; normal-background: root.combo-bg; hover-background: root.combo-bg-hover; disabled-background: root.combo-bg-disabled; selected-background: root.combo-selected-bg; normal-border: root.combo-border; hover-border: root.combo-border-hover; normal-text: root.text-body; disabled-text: root.text-soft; muted-text: root.text-muted; selected-text: root.text-body; }
                                            Text { text: "自定义不改质量字段；无损=q100；视觉无损=vq75；平衡=vq50；快速=vq25；急速=vq17。"; horizontal-stretch: 1; color: root.text-body; font-size: 12px; wrap: word-wrap; vertical-alignment: center; }
                                        }

                                        HorizontalLayout {
                                            height: 48px;
                                            spacing: 10px;
                                            Text { text: "格式"; width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                            SoftComboBox { viewport-height: root.height; close-generation: root.combo-close-generation; popup-requested => { root.combo-popup-requested(); } popup-finished => { root.combo-popup-finished(); } model: [{ text: "AVIF", enabled: true }, { text: "WebP", enabled: true }, { text: "JXL", enabled: true }, { text: "JPGLI", enabled: true }]; current-index <=> root.format-index; enabled: !root.running; width: root.parameter-control-width; height: root.parameter-control-height; normal-background: root.combo-bg; hover-background: root.combo-bg-hover; disabled-background: root.combo-bg-disabled; selected-background: root.combo-selected-bg; normal-border: root.combo-border; hover-border: root.combo-border-hover; normal-text: root.text-body; disabled-text: root.text-soft; muted-text: root.text-muted; selected-text: root.text-body; }
                                            Text { text: "输出格式：AVIF 体积优先；WebP 兼容网页；JXL 高保真；JPGLI 使用 Jpegli 生成 JPEG 兼容 bitstream。"; horizontal-stretch: 1; color: root.text-body; font-size: 12px; wrap: word-wrap; vertical-alignment: center; }
                                        }

                                        if root.format-index == 0: HorizontalLayout {
                                            height: 48px;
                                            spacing: 10px;
                                            Text { text: "编码器"; width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                            SoftComboBox { viewport-height: root.height; close-generation: root.combo-close-generation; popup-requested => { root.combo-popup-requested(); } popup-finished => { root.combo-popup-finished(); } model: root.avif-encoder-options; current-index <=> root.avif-encoder-index; enabled: !root.running; width: root.parameter-control-width; height: root.parameter-control-height; normal-background: root.combo-bg; hover-background: root.combo-bg-hover; disabled-background: root.combo-bg-disabled; selected-background: root.combo-selected-bg; normal-border: root.combo-border; hover-border: root.combo-border-hover; normal-text: root.text-body; disabled-text: root.text-soft; muted-text: root.text-muted; selected-text: root.text-body; }
                                            Text { text: "自动按资源选择；svt-av1-hdr 偏高吞吐；aom 支持 grid；zenrav1e 为实验项，需在设置中启用。"; horizontal-stretch: 1; color: root.text-body; font-size: 12px; wrap: word-wrap; vertical-alignment: center; }
                                        }

                                        HorizontalLayout {
                                            height: 48px;
                                            spacing: 10px;
                                            Text { text: "线程"; width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                            LineEdit { text <=> root.threads-text; placeholder-text: "自动/线程数"; enabled: !root.running; width: root.parameter-control-width; height: root.parameter-control-height; }
                                            Text { text: "自动或正整数；留空等同自动。线程越多不一定越快，程序会结合任务数与内存预算规划并发。"; horizontal-stretch: 1; color: root.text-body; font-size: 12px; wrap: word-wrap; vertical-alignment: center; }
                                        }

                                        HorizontalLayout {
                                            height: 48px;
                                            spacing: 10px;
                                            Text { text: "内存"; width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                            LineEdit { text <=> root.memory-limit-text; placeholder-text: "例如 4（单位 GiB）"; input-type: number; enabled: !root.running; width: root.parameter-control-width; height: root.parameter-control-height; }
                                            Text { text: "只能填写数字，单位固定 GiB；例如 4 表示 4 GiB。留空时按系统可用内存自动规划，避免过量并发。"; horizontal-stretch: 1; color: root.text-body; font-size: 12px; wrap: word-wrap; vertical-alignment: center; }
                                        }

                                        HorizontalLayout {
                                            height: 48px;
                                            spacing: 10px;
                                            Text { text: "尺寸限制"; width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                            SoftComboBox { viewport-height: root.height; close-generation: root.combo-close-generation; popup-requested => { root.combo-popup-requested(); } popup-finished => { root.combo-popup-finished(); } model: [{ text: "自动", enabled: true }, { text: "无限制", enabled: true }, { text: "手动", enabled: true }]; current-index <=> root.size-limit-index; enabled: !root.running; width: root.parameter-control-width; height: root.parameter-control-height; normal-background: root.combo-bg; hover-background: root.combo-bg-hover; disabled-background: root.combo-bg-disabled; selected-background: root.combo-selected-bg; normal-border: root.combo-border; hover-border: root.combo-border-hover; normal-text: root.text-body; disabled-text: root.text-soft; muted-text: root.text-muted; selected-text: root.text-body; }
                                            Text { text: "自动按格式常用最大边长限制；手动会取宽、高、长边、短边中最严格的缩小比例。"; horizontal-stretch: 1; color: root.text-body; font-size: 12px; wrap: word-wrap; vertical-alignment: center; }
                                        }

                                        if root.size-limit-index == 2: HorizontalLayout {
                                            height: 48px;
                                            spacing: 10px;
                                            Text { text: "手动尺寸"; width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                            LineEdit { text <=> root.max-width-text; placeholder-text: "最大宽"; input-type: number; enabled: !root.running; width: 100px; height: root.parameter-control-height; }
                                            LineEdit { text <=> root.max-height-text; placeholder-text: "最大高"; input-type: number; enabled: !root.running; width: 100px; height: root.parameter-control-height; }
                                            LineEdit { text <=> root.max-long-edge-text; placeholder-text: "最大长边"; input-type: number; enabled: !root.running; width: 100px; height: root.parameter-control-height; }
                                            LineEdit { text <=> root.max-short-edge-text; placeholder-text: "最大短边"; input-type: number; enabled: !root.running; width: 100px; height: root.parameter-control-height; }
                                        }

                                        HorizontalLayout {
                                            height: 48px;
                                            spacing: 10px;
                                            Text { text: "质量"; width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                            LineEdit { text <=> root.quality-text; placeholder-text: root.visual-quality-text.is-empty ? "1-100/q90/0.9" : "由视觉质量自动控制"; enabled: !root.running && root.visual-quality-text.is-empty; width: root.parameter-control-width; opacity: root.visual-quality-text.is-empty ? 1.0 : 0.56; height: root.parameter-control-height; }
                                            Text { text: "数值越高质量越好、体积越大。填写视觉质量后，此项会由搜索流程接管。"; horizontal-stretch: 1; color: root.text-body; font-size: 12px; wrap: word-wrap; vertical-alignment: center; }
                                        }

                                        HorizontalLayout {
                                            height: 48px;
                                            spacing: 10px;
                                            Text { text: "视觉质量"; width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                            LineEdit { text <=> root.visual-quality-text; placeholder-text: "空由质量决定，1-100"; input-type: number; enabled: !root.running; width: root.parameter-control-width; height: root.parameter-control-height; }
                                            Text { text: "留空关闭；填写 1-100 后会搜索多个候选，并以 GMSD/MS-SSIM 等指标判断是否达到目标质量。"; horizontal-stretch: 1; color: root.text-body; font-size: 12px; wrap: word-wrap; vertical-alignment: center; }
                                        }

                                        if root.format-index != 3: HorizontalLayout {
                                            height: 48px;
                                            spacing: 10px;
                                            Text { text: "速度"; width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                            LineEdit { text <=> root.speed-text; placeholder-text: "默认/可选0-10"; enabled: !root.running; width: root.parameter-control-width; height: root.parameter-control-height; }
                                            Text { text: "数值越低通常越慢但压缩率更高。留空使用当前预设与编码器默认速度。"; horizontal-stretch: 1; color: root.text-body; font-size: 12px; wrap: word-wrap; vertical-alignment: center; }
                                        }

                                        if root.format-index == 0: HorizontalLayout {
                                            height: 48px;
                                            spacing: 10px;
                                            Text { text: "位深"; width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                            LineEdit { text <=> root.bit-depth-text; placeholder-text: "保持原片"; enabled: !root.running; width: root.parameter-control-width; height: root.parameter-control-height; }
                                            Text { text: "支持 8/10/12-bit；留空会按源图与编码器能力自动选择。"; horizontal-stretch: 1; color: root.text-body; font-size: 12px; wrap: word-wrap; vertical-alignment: center; }
                                        }

                                        if (root.format-index == 0 && root.avif-encoder-index != 1) || root.format-index == 3: HorizontalLayout {
                                            height: 48px;
                                            spacing: 10px;
                                            Text { text: "色度采样"; width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                            SoftComboBox { viewport-height: root.height; close-generation: root.combo-close-generation; popup-requested => { root.combo-popup-requested(); } popup-finished => { root.combo-popup-finished(); } model: [{ text: "自动", enabled: true }, { text: "444", enabled: true }, { text: "422", enabled: true }, { text: "420", enabled: true }]; current-index <=> root.chroma-index; enabled: !root.running; width: root.parameter-control-width; height: root.parameter-control-height; normal-background: root.combo-bg; hover-background: root.combo-bg-hover; disabled-background: root.combo-bg-disabled; selected-background: root.combo-selected-bg; normal-border: root.combo-border; hover-border: root.combo-border-hover; normal-text: root.text-body; disabled-text: root.text-soft; muted-text: root.text-muted; selected-text: root.text-body; }
                                            Text { text: root.format-index == 3 ? "JPGLI 支持 444/422/420；自动使用 Jpegli 默认采样，XYB 开启时使用 XYB 默认采样。" : "444 保留更多颜色细节；420 体积更小但色彩采样更强。AVIF aom/自动可用。"; horizontal-stretch: 1; color: root.text-body; font-size: 12px; wrap: word-wrap; vertical-alignment: center; }
                                        }

                                        if root.format-index == 3: HorizontalLayout {
                                            height: 48px;
                                            spacing: 10px;
                                            Text { text: "渐进"; width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                            SoftComboBox { viewport-height: root.height; close-generation: root.combo-close-generation; popup-requested => { root.combo-popup-requested(); } popup-finished => { root.combo-popup-finished(); } model: [{ text: "关闭", enabled: true }, { text: "普通", enabled: true }, { text: "更细", enabled: true }]; current-index <=> root.jpegli-progressive-index; enabled: !root.running; width: root.parameter-control-width; height: root.parameter-control-height; normal-background: root.combo-bg; hover-background: root.combo-bg-hover; disabled-background: root.combo-bg-disabled; selected-background: root.combo-selected-bg; normal-border: root.combo-border; hover-border: root.combo-border-hover; normal-text: root.text-body; disabled-text: root.text-soft; muted-text: root.text-muted; selected-text: root.text-body; }
                                            Text { text: "关闭为顺序 JPEG；普通/更细会使用多扫描渐进编码，默认更细。"; horizontal-stretch: 1; color: root.text-body; font-size: 12px; wrap: word-wrap; vertical-alignment: center; }
                                        }

                                        if root.format-index == 3 && root.jpegli-progressive-index == 0: HorizontalLayout {
                                            height: 48px;
                                            spacing: 10px;
                                            Text { text: "哈夫曼"; width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                            CheckBox { text: "优化哈夫曼表"; checked <=> root.jpegli-optimize-huffman; enabled: !root.running; width: root.parameter-control-width; }
                                            Text { text: "关闭优化可使用固定表，编码更直接但体积通常更大。"; horizontal-stretch: 1; color: root.text-body; font-size: 12px; wrap: word-wrap; vertical-alignment: center; }
                                        }

                                        if root.format-index == 3: HorizontalLayout {
                                            height: 48px;
                                            spacing: 10px;
                                            Text { text: "XYB"; width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                            CheckBox { text: "启用 XYB"; checked <=> root.jpegli-xyb; enabled: !root.running; width: root.parameter-control-width; }
                                            Text { text: "实验模式；开启后不写入源 ICC，适合单独测试体积与兼容性。"; horizontal-stretch: 1; color: root.text-body; font-size: 12px; wrap: word-wrap; vertical-alignment: center; }
                                        }

                                        if root.format-index == 0: HorizontalLayout {
                                            height: 48px;
                                            spacing: 10px;
                                            Text { text: "透明通道"; width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                            SoftComboBox { viewport-height: root.height; close-generation: root.combo-close-generation; popup-requested => { root.combo-popup-requested(); } popup-finished => { root.combo-popup-finished(); } model: [{ text: "强制开启", enabled: true }, { text: "自动", enabled: true }, { text: "关闭", enabled: true }]; current-index <=> root.alpha-policy-index; enabled: !root.running; width: root.parameter-control-width; height: root.parameter-control-height; normal-background: root.combo-bg; hover-background: root.combo-bg-hover; disabled-background: root.combo-bg-disabled; selected-background: root.combo-selected-bg; normal-border: root.combo-border; hover-border: root.combo-border-hover; normal-text: root.text-body; disabled-text: root.text-soft; muted-text: root.text-muted; selected-text: root.text-body; }
