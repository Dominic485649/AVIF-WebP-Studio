                                LineEdit { accessible-label: @tr("右键位深"); text <=> root.menu-bit-depth-text; placeholder-text: @tr("留空保持原片"); input-type: number; enabled: !root.running; width: root.parameter-control-width; height: root.parameter-control-height; }
                                Text { text: @tr("不适用的格式会在保存/转换时忽略或按格式规则校验。"); horizontal-stretch: 1; color: root.text-body; font-size: 12px; wrap: word-wrap; vertical-alignment: center; }
                            }
                            HorizontalLayout { height: 48px; spacing: 10px;
                                Text { text: @tr("速度"); width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                LineEdit { accessible-label: @tr("右键速度"); text <=> root.menu-speed-text; placeholder-text: @tr("0-10，留空默认"); input-type: number; enabled: !root.running; width: root.parameter-control-width; height: root.parameter-control-height; }
                                Text { text: @tr("AVIF/WebP/JXL 可用；其他格式会忽略。"); horizontal-stretch: 1; color: root.text-body; font-size: 12px; wrap: word-wrap; vertical-alignment: center; }
                            }
                            HorizontalLayout { height: 48px; spacing: 10px;
                                Text { text: @tr("色度采样"); width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                            SoftComboBox { accessible-name: @tr("右键色度采样"); viewport-height: root.height; close-generation: root.combo-close-generation; popup-requested => { root.combo-popup-requested(); } popup-finished => { root.combo-popup-finished(); } model: [{ text: @tr("自动"), enabled: true }, { text: "444", enabled: true }, { text: "422", enabled: true }, { text: "420", enabled: true }]; current-index <=> root.menu-chroma-index; enabled: !root.running; width: root.parameter-control-width; height: root.parameter-control-height; normal-background: root.combo-bg; hover-background: root.combo-bg-hover; disabled-background: root.combo-bg-disabled; selected-background: root.combo-selected-bg; normal-border: root.combo-border; hover-border: root.combo-border-hover; normal-text: root.text-body; disabled-text: root.text-soft; muted-text: root.text-muted; selected-text: root.text-body; }
                                Text { text: @tr("AVIF/JPGLI 可用；其他格式会忽略。"); horizontal-stretch: 1; color: root.text-body; font-size: 12px; wrap: word-wrap; vertical-alignment: center; }
                            }
                            HorizontalLayout { height: 48px; spacing: 10px;
                                Text { text: @tr("透明通道"); width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                            SoftComboBox { accessible-name: @tr("右键透明通道"); viewport-height: root.height; close-generation: root.combo-close-generation; popup-requested => { root.combo-popup-requested(); } popup-finished => { root.combo-popup-finished(); } model: [{ text: @tr("强制"), enabled: true }, { text: @tr("自动"), enabled: true }, { text: @tr("关闭"), enabled: true }]; current-index <=> root.menu-alpha-policy-index; enabled: !root.running; width: root.parameter-control-width; height: root.parameter-control-height; normal-background: root.combo-bg; hover-background: root.combo-bg-hover; disabled-background: root.combo-bg-disabled; selected-background: root.combo-selected-bg; normal-border: root.combo-border; hover-border: root.combo-border-hover; normal-text: root.text-body; disabled-text: root.text-soft; muted-text: root.text-muted; selected-text: root.text-body; }
                                Text { text: @tr("仅 AVIF 可用；JPGLI 不支持强制保留透明通道。"); horizontal-stretch: 1; color: root.text-body; font-size: 12px; wrap: word-wrap; vertical-alignment: center; }
                            }
                            if root.menu-format-index == 3: HorizontalLayout { height: 48px; spacing: 10px;
                                Text { text: @tr("渐进"); width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                            SoftComboBox { accessible-name: @tr("右键 JPGLI 渐进级别"); viewport-height: root.height; close-generation: root.combo-close-generation; popup-requested => { root.combo-popup-requested(); } popup-finished => { root.combo-popup-finished(); } model: [{ text: @tr("关闭"), enabled: true }, { text: @tr("普通"), enabled: true }, { text: @tr("更细"), enabled: true }]; current-index <=> root.menu-jpegli-progressive-index; enabled: !root.running; width: root.parameter-control-width; height: root.parameter-control-height; normal-background: root.combo-bg; hover-background: root.combo-bg-hover; disabled-background: root.combo-bg-disabled; selected-background: root.combo-selected-bg; normal-border: root.combo-border; hover-border: root.combo-border-hover; normal-text: root.text-body; disabled-text: root.text-soft; muted-text: root.text-muted; selected-text: root.text-body; }
                                Text { text: @tr("关闭为顺序 JPEG；普通和更细使用渐进编码。"); horizontal-stretch: 1; color: root.text-body; font-size: 12px; wrap: word-wrap; vertical-alignment: center; }
                            }
                            if root.menu-format-index == 3: HorizontalLayout { height: 48px; spacing: 10px;
                                Text { text: @tr("哈夫曼表"); width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                CheckBox { text: @tr("优化哈夫曼表"); checked <=> root.menu-jpegli-optimize-huffman; enabled: !root.running; width: root.parameter-control-width; }
                                Text { text: @tr("渐进 JPEG 会自动启用哈夫曼表优化。"); horizontal-stretch: 1; color: root.text-body; font-size: 12px; wrap: word-wrap; vertical-alignment: center; }
                            }
                            if root.menu-format-index == 3: HorizontalLayout { height: 48px; spacing: 10px;
                                Text { text: "XYB"; width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                CheckBox { text: @tr("启用 XYB"); checked <=> root.menu-jpegli-xyb; enabled: !root.running; width: root.parameter-control-width; }
                                Text { text: @tr("JPGLI 实验选项。"); horizontal-stretch: 1; color: root.text-body; font-size: 12px; wrap: word-wrap; vertical-alignment: center; }
                            }
                            HorizontalLayout { height: 48px; spacing: 10px;
                                Text { text: @tr("尺寸限制"); width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                            SoftComboBox { accessible-name: @tr("右键图片尺寸限制"); viewport-height: root.height; close-generation: root.combo-close-generation; popup-requested => { root.combo-popup-requested(); } popup-finished => { root.combo-popup-finished(); } model: [{ text: @tr("自动"), enabled: true }, { text: @tr("无限制"), enabled: true }, { text: @tr("手动"), enabled: true }]; current-index <=> root.menu-size-limit-index; enabled: !root.running; width: root.parameter-control-width; height: root.parameter-control-height; normal-background: root.combo-bg; hover-background: root.combo-bg-hover; disabled-background: root.combo-bg-disabled; selected-background: root.combo-selected-bg; normal-border: root.combo-border; hover-border: root.combo-border-hover; normal-text: root.text-body; disabled-text: root.text-soft; muted-text: root.text-muted; selected-text: root.text-body; }
                                Text { text: @tr("手动限制会取宽、高、长边、短边中最严格的缩小比例。"); horizontal-stretch: 1; color: root.text-body; font-size: 12px; wrap: word-wrap; vertical-alignment: center; }
                            }
                            if root.menu-size-limit-index == 2: HorizontalLayout { height: 48px; spacing: 10px;
                                Text { text: @tr("手动尺寸"); width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                LineEdit { accessible-label: @tr("右键最大宽度"); text <=> root.menu-max-width-text; placeholder-text: @tr("最大宽"); input-type: number; enabled: !root.running; width: 100px; height: root.parameter-control-height; }
                                LineEdit { accessible-label: @tr("右键最大高度"); text <=> root.menu-max-height-text; placeholder-text: @tr("最大高"); input-type: number; enabled: !root.running; width: 100px; height: root.parameter-control-height; }
                                LineEdit { accessible-label: @tr("右键最大长边"); text <=> root.menu-max-long-edge-text; placeholder-text: @tr("最大长边"); input-type: number; enabled: !root.running; width: 100px; height: root.parameter-control-height; }
                                LineEdit { accessible-label: @tr("右键最大短边"); text <=> root.menu-max-short-edge-text; placeholder-text: @tr("最大短边"); input-type: number; enabled: !root.running; width: 100px; height: root.parameter-control-height; }
                            }
                            HorizontalLayout { spacing: root.page-gap;
                                CheckBox { text: @tr("移除元数据"); checked <=> root.menu-strip-metadata; enabled: !root.running; }
                                if root.wic-ui-visible: CheckBox { text: @tr("允许 WIC 兜底"); checked <=> root.menu-allow-wic-fallback; enabled: !root.running; }
                                CheckBox { text: @tr("完成后关闭窗口"); checked <=> root.menu-close-on-finish; enabled: !root.running; }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                            }
                        }
                    }
                }

                if root.selected-page == 1: VerticalLayout {
                    spacing: 8px;

                    Rectangle {
                        border-radius: 8px;
                        background: root.panel-bg;
                        border-color: root.panel-border;
                        border-width: 1px;
                        animate background, border-color { duration: 180ms; easing: ease-out; }

                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;

                            VerticalLayout {
                                spacing: 8px;
                                horizontal-stretch: 1;

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: @tr("输入路径"); width: 78px; color: root.text-body; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                                    LineEdit { accessible-label: @tr("输入路径"); text <=> root.input-path; placeholder-text: @tr("输入图片文件或文件夹路径，回车加入队列"); enabled: !root.running; min-width: 120px; horizontal-stretch: 1; height: root.control-button-height; accepted(text) => { root.input-path-accepted(text); } }
                                    Rectangle {
                                        width: root.control-button-width * 2 + 10px;
                                        height: root.control-button-height;
                                        background: transparent;
                                        HorizontalLayout {
                                            spacing: 10px;
                                            SoftComboBox { accessible-name: @tr("输入类型"); viewport-height: root.height; close-generation: root.combo-close-generation; popup-requested => { root.combo-popup-requested(); } popup-finished => { root.combo-popup-finished(); } model: [{ text: @tr("文件"), enabled: true }, { text: @tr("文件夹"), enabled: true }]; current-index <=> root.input-mode-index; enabled: !root.running; width: root.control-button-width; height: root.control-button-height; normal-background: root.combo-bg; hover-background: root.combo-bg-hover; disabled-background: root.combo-bg-disabled; selected-background: root.combo-selected-bg; normal-border: root.combo-border; hover-border: root.combo-border-hover; normal-text: root.text-body; disabled-text: root.text-soft; muted-text: root.text-muted; selected-text: root.accent-strong; }
                                            SoftButton { dark-mode: root.dark-mode; text: @tr("选择"); width: root.control-button-width; height: root.control-button-height; enabled: !root.running; clicked => { root.browse-input(); } }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: @tr("输出目录"); width: 78px; color: root.text-body; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                                    LineEdit { accessible-label: @tr("输出目录"); text <=> root.output-dir; placeholder-text: @tr("默认与输入同目录"); enabled: !root.running; min-width: 120px; horizontal-stretch: 1; height: root.control-button-height; }
                                    Rectangle {
                                        width: root.control-button-width * 2 + 10px;
                                        height: root.control-button-height;
                                        background: transparent;
                                        HorizontalLayout {
                                            spacing: 10px;
                                            SoftButton { dark-mode: root.dark-mode; text: @tr("打开"); width: root.control-button-width; height: root.control-button-height; clicked => { root.open-output(); } }
                                            SoftButton { dark-mode: root.dark-mode; text: @tr("选择"); width: root.control-button-width; height: root.control-button-height; enabled: !root.running; clicked => { root.browse-output(); } }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: @tr("命名规则"); width: 78px; color: root.text-body; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                                    LineEdit { accessible-label: @tr("命名规则"); text <=> root.template-text; // @tr 内的 {…} 是格式占位符，这里的花括号是要原样显示给用户的模板变量，必须转义成 {{ }}。
                                            placeholder-text: @tr("例：{{name}}_{{date}}"); enabled: !root.running; min-width: 120px; horizontal-stretch: 1; height: 38px; }
                                    Rectangle {
                                        width: 302px;
                                        height: 38px;
                                        background: transparent;
                                        HorizontalLayout {
                                            spacing: 10px;
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                            Text { text: @tr("重复处理"); width: 68px; color: root.text-body; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                                            SoftComboBox {
                                                accessible-name: @tr("重复处理");
                                                viewport-height: root.height;
                                                close-generation: root.combo-close-generation;
                                                popup-requested => { root.combo-popup-requested(); }
                                                popup-finished => { root.combo-popup-finished(); }
                                                model: [{ text: @tr("覆盖"), enabled: true }, { text: @tr("跳过"), enabled: true }, { text: @tr("追加时间"), enabled: true }, { text: @tr("追加随机"), enabled: true }];
                                                current-index <=> root.collision-index;
                                                enabled: !root.running;
                                                width: 178px;
                                                normal-background: root.combo-bg;
                                                hover-background: root.combo-bg-hover;
                                                disabled-background: root.combo-bg-disabled;
                                                selected-background: root.combo-selected-bg;
                                                normal-border: root.combo-border;
                                                hover-border: root.combo-border-hover;
                                                normal-text: root.text-body;
                                                disabled-text: root.text-soft;
                                                muted-text: root.text-muted;
                                                selected-text: root.accent-strong;
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    Rectangle { width: 88px; background: transparent; }
                                    SoftButton { dark-mode: root.dark-mode; text: @tr("参数"); width: 58px; height: 38px; enabled: !root.running; checkable: true; checked: root.template-params-selected; clicked => { root.toggle-template-token("{params}"); } }
                                    SoftButton { dark-mode: root.dark-mode; text: @tr("日期"); width: 58px; height: 38px; enabled: !root.running; checkable: true; checked: root.template-date-selected; clicked => { root.toggle-template-token("{date}"); } }
                                    SoftButton { dark-mode: root.dark-mode; text: @tr("时间"); width: 58px; height: 38px; enabled: !root.running; checkable: true; checked: root.template-time-selected; clicked => { root.toggle-template-token("{time}"); } }
                                    SoftButton { dark-mode: root.dark-mode; text: @tr("随机"); width: 58px; height: 38px; enabled: !root.running; checkable: true; checked: root.template-rand-selected; clicked => { root.toggle-template-token("{rand}"); } }
                                    SoftButton { dark-mode: root.dark-mode; text: @tr("哈希"); width: 58px; height: 38px; enabled: !root.running; checkable: true; checked: root.template-hash8-selected; clicked => { root.toggle-template-token("{hash8}"); } }
                                    SoftButton { dark-mode: root.dark-mode; text: "SHA"; width: 58px; height: 38px; enabled: !root.running; checkable: true; checked: root.template-sha2568-selected; clicked => { root.toggle-template-token("{sha2568}"); } }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                }
                            }

                                HorizontalLayout {
                                    spacing: root.page-gap;
                                    CheckBox { text: @tr("写入 CSV 报告"); checked <=> root.write-summary; enabled: !root.running; }
                                    CheckBox { text: @tr("写入运行日志"); checked <=> root.write-log; enabled: !root.running; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                }

                                HorizontalLayout {
                                spacing: root.page-gap;
                                SoftButton { dark-mode: root.dark-mode; text: root.running ? (root.force-terminate-supported ? @tr("强制终止") : @tr("停止任务")) : @tr("开始转换"); variant: root.running && root.force-terminate-supported ? "danger" : "action"; height: 42px; enabled: true; horizontal-stretch: 1; clicked => { root.start-conversion(); } }
                                if root.force-terminate-supported: SoftButton { dark-mode: root.dark-mode; text: @tr("停止任务"); variant: "outline"; height: 42px; enabled: root.running; horizontal-stretch: 1; clicked => { root.cancel-conversion(); } }
                                SoftButton { dark-mode: root.dark-mode; text: @tr("清空队列"); height: 42px; enabled: !root.running; horizontal-stretch: 1; clicked => { root.clear-tasks(); } }
                            }

                        }
                    }

                    Rectangle {
                        border-radius: 8px;
                        background: root.panel-bg;
                        border-color: root.panel-border;
                        border-width: 1px;
                        vertical-stretch: 1;
                        animate background, border-color { duration: 180ms; easing: ease-out; }

                        VerticalLayout {
                            padding: 10px;
                            spacing: 6px;

                            HorizontalLayout {
                                height: 34px;
                                spacing: 10px;
                                Text {
                                    text: @tr("待处理 ") + root.queue-pending-count + @tr("  ·  处理中 ") + root.queue-running-count + @tr("  ·  成功 ") + root.queue-success-count + @tr("  ·  失败 ") + root.queue-failed-count;
                                    color: root.text-muted;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                CheckBox {
                                    text: @tr("仅看失败");
                                    checked <=> root.queue-failed-only;
                                    enabled: root.task-rows.length > 0;
                                    toggled => {
                                        if (root.queue-failed-only && root.selected-queue-valid && root.task-rows[root.selected-queue-index].state != 3) {
                                            root.selected-queue-index = -1;
                                        }
                                    }
                                }
                                SoftButton {
                                    dark-mode: root.dark-mode;
                                    text: @tr("重试失败");
                                    height: 32px;
                                    width: 86px;
                                    enabled: !root.running && root.queue-failed-count > 0;
                                    clicked => { root.retry-failed(); }
                                }
                            }

                            Rectangle {
                                vertical-stretch: 1;
                                border-radius: 4px;
                                background: root.dark-mode ? #151b25 : #ffffff;
                                border-width: 0px;
                                clip: true;
                                animate background, border-color { duration: 180ms; easing: ease-out; }

                                VerticalLayout {
                                    spacing: 0px;

                                    Rectangle {
                                        height: 34px;
                                        background: root.field-bg;
                                        border-color: root.field-border;
                                        border-width: 0px;
                                        animate background, border-color { duration: 180ms; easing: ease-out; }
                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 10px;
                                            Text { text: "#"; width: 40px; color: root.text-muted; font-size: 12px; vertical-alignment: center; horizontal-alignment: center; }
                                            Text { text: @tr("文件名"); width: root.queue-filename-width; color: root.text-muted; font-size: 12px; vertical-alignment: center; }
                                            Text { text: @tr("目录"); horizontal-stretch: 1; color: root.text-muted; font-size: 12px; vertical-alignment: center; }
                                            Text { text: @tr("大小"); width: root.queue-size-width; color: root.text-muted; font-size: 12px; vertical-alignment: center; }
                                            Text { text: @tr("状态"); width: root.queue-status-width; color: root.text-muted; font-size: 12px; vertical-alignment: center; }
                                            Text { text: @tr("输出或日志"); horizontal-stretch: 1; color: root.text-muted; font-size: 12px; vertical-alignment: center; }
                                        }
                                    }

                                    Rectangle {
                                        vertical-stretch: 1;
                                        background: root.dark-mode ? #151b25 : #ffffff;

                                        if root.task-rows.length == 0 || (root.queue-failed-only && root.queue-failed-count == 0): Text {
                                            text: root.task-rows.length == 0 ? @tr("队列为空") : @tr("没有失败项");
                                            color: root.text-muted;
                                            font-size: 13px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        if root.task-rows.length > 0 && (!root.queue-failed-only || root.queue-failed-count > 0): ListView {
                                     accessible-role: list;
                                     accessible-label: @tr("编码任务");
                                     accessible-item-count: root.queue-failed-only ? root.queue-failed-count : root.task-rows.length;
                                     for row[index] in root.task-rows: Rectangle {
                                         height: (!root.queue-failed-only || row.state == 3) ? 34px : 0px;
                                         if !root.queue-failed-only || row.state == 3: drop-row := DropArea {
                                         property <length> hover-y: 0px;
                                         property <int> drop-index: index + (drop-row.hover-y > drop-row.height / 2 ? 1 : 0);
                                         width: parent.width;
                                         height: 34px;
                                         can-drop(event) => {
                                             drop-row.hover-y = event.position.y;
                                             return root.queue-drag-can-drop(event, drop-row.drop-index);
                                         }
                                         dropped(event) => {
                                             return root.queue-drag-dropped(event, drop-row.drop-index);
                                         }
                                         row-drag := DragArea {
                                             enabled: !root.running && !row.locked;
                                             allow-move: !root.running && !row.locked;
                                             data: root.queue-drag-data(index);
                                             opacity: row-drag.dragging ? 0.45 : 1.0;
                                             Rectangle {
                                                 width: parent.width;
                                                 height: parent.height;
                                                 background: root.selected-queue-index == index ? root.accent-soft : (drop-row.has-drag ? (root.dark-mode ? #24324a : #e7f1ff) : (row-touch.has-hover ? (root.dark-mode ? #222d3c : #edf5ff) : (index / 2 * 2 == index ? (root.dark-mode ? #1c2533 : #f4f8fe) : transparent)));
                                                 border-radius: 3px;
                                                 accessible-role: list-item;
                                                 accessible-label: row.filename + "，" + row.status;
                                                 accessible-item-selectable: true;
                                                 accessible-item-selected: root.selected-queue-index == index;
                                                 animate y, background { duration: 190ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }
                                                 HorizontalLayout {
                                                     padding-left: 10px;
                                                     padding-right: 10px;
                                                     spacing: 10px;
                                                     Text { text: row.order; width: 40px; color: root.text-muted; font-size: 12px; vertical-alignment: center; horizontal-alignment: center; }
                                                     Text { text: row.filename; width: root.queue-filename-width; color: root.text-body; font-size: 12px; overflow: elide; vertical-alignment: center; }
                                                     Text { text: row.folder; horizontal-stretch: 1; color: root.text-muted; font-size: 12px; overflow: elide; vertical-alignment: center; }
                                                     Text { text: row.size; width: root.queue-size-width; color: root.text-muted; font-size: 12px; vertical-alignment: center; }
                                                     Text { text: row.status; width: root.queue-status-width; color: row.warning ? root.warning : root.text-body; font-size: 12px; overflow: elide; vertical-alignment: center; }
                                                     Text { text: row.output.is-empty ? row.log : row.output; horizontal-stretch: 1; color: row.warning ? root.warning : root.text-muted; font-size: 12px; overflow: elide; vertical-alignment: center; }
                                                 }
                                                 row-touch := TouchArea {
                                                     width: parent.width;
                                                     height: parent.height;
                                                     pointer-event(event) => {
                                                         if ((event.button == PointerEventButton.left || event.button == PointerEventButton.right) && event.kind == PointerEventKind.down) {
                                                             root.selected-queue-index = index;
                                                         }
                                                         if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                                                             root.open-queue-menu(index, row-touch.absolute-position.x + row-touch.mouse-x, row-touch.absolute-position.y + row-touch.mouse-y);
                                                         }
                                                         root.queue-row-pointer-event(
                                                             index,
                                                             event.button == PointerEventButton.left ? 0 : (event.button == PointerEventButton.right ? 1 : 2),
                                                             event.kind == PointerEventKind.down ? 0 : (event.kind == PointerEventKind.up ? 1 : (event.kind == PointerEventKind.move ? 2 : 3)),
                                                             row-touch.mouse-y / 1px
                                                         );
                                                     }
                                                 }
                                             }
                                         }
                                         if drop-row.has-drag: Rectangle {
                                             y: drop-row.hover-y > drop-row.height / 2 ? parent.height - 2px : 0px;
                                             width: parent.width;
                                             height: 2px;
                                             background: root.accent-strong;
                                             border-radius: 1px;
                                         }
                                         }
                                     }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                height: 10px;
                                border-radius: 5px;
                                background: root.progress-track;
                                clip: true;
                                animate background { duration: 180ms; easing: ease-out; }
                                Rectangle {
                                    x: 0px;
                                    width: max(0px, min(parent.width, parent.width * root.progress));
                                    height: parent.height;
                                    border-radius: 5px;
                                    background: root.progress-fill;
                                    animate width, background { duration: 160ms; easing: ease-out; }
                                }
                            }

                            Text { text: @tr("总进度：") + root.status-text; color: root.text-muted; font-size: 12px; overflow: elide; }
                        }

                        if root.selected-queue-valid: Rectangle {
                            x: 10px;
                            y: 50px;
                            width: parent.width - 20px;
                            height: min(154px, max(96px, parent.height - 94px));
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: root.panel-border;
                            background: root.panel-bg-soft;
                            clip: true;

                            VerticalLayout {
                                padding: 10px;
                                spacing: 6px;

                                HorizontalLayout {
                                    height: 28px;
                                    spacing: 8px;
                                    Text {
                                        text: root.task-rows[root.selected-queue-index].filename + " · " + root.task-rows[root.selected-queue-index].status;
                                        color: root.text-strong;
                                        font-size: 13px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                    SoftButton {
                                        dark-mode: root.dark-mode;
                                        text: "×";
                                        accessible-name: @tr("关闭详情");
                                        width: 30px;
                                        height: 28px;
                                        clicked => { root.selected-queue-index = -1; }
                                    }
                                }

                                ScrollView {
                                    vertical-stretch: 1;
                                    VerticalLayout {
                                        spacing: 4px;
                                        Text { text: @tr("输入：") + root.task-rows[root.selected-queue-index].input-path; color: root.text-body; font-size: 12px; wrap: word-wrap; }
                                        Text { text: @tr("输出：") + (root.task-rows[root.selected-queue-index].output-path.is-empty ? @tr("尚未生成") : root.task-rows[root.selected-queue-index].output-path); color: root.text-body; font-size: 12px; wrap: word-wrap; }
                                        Text { text: @tr("编码器：") + (root.task-rows[root.selected-queue-index].encoder.is-empty ? @tr("尚未确定") : root.task-rows[root.selected-queue-index].encoder) + @tr("  ·  线程：") + (root.task-rows[root.selected-queue-index].threads.is-empty ? "-" : root.task-rows[root.selected-queue-index].threads); color: root.text-body; font-size: 12px; wrap: word-wrap; }
                                        Text { text: @tr("阶段：") + (root.task-rows[root.selected-queue-index].stage-timings.is-empty ? @tr("尚无数据") : root.task-rows[root.selected-queue-index].stage-timings); color: root.text-body; font-size: 12px; wrap: word-wrap; }
                                        Text { text: @tr("错误/日志：") + (root.task-rows[root.selected-queue-index].log.is-empty ? @tr("无") : root.task-rows[root.selected-queue-index].log); color: root.task-rows[root.selected-queue-index].state == 3 ? root.warning : root.text-muted; font-size: 12px; wrap: word-wrap; }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.selected-page == 4 && root.show-update-changelog: ScrollView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    viewport-width: parent.width;
                    Rectangle {
                        border-radius: 8px;
                        background: root.panel-bg;
                        border-color: root.panel-border;
                        border-width: 1px;
                        min-height: parent.height;
                        VerticalLayout {
                            padding: 24px;
                            spacing: 14px;
                            Text { text: @tr("更新日志"); color: root.text-strong; font-size: 22px; font-weight: 800; }
                            Text {
                                text: @tr("按版本记录全部已验证的发布日志。更新检查由程序自动完成。");
                                color: root.text-body;
                                font-size: 13px;
                                wrap: word-wrap;
                                min-width: 0px;
                                width: 100%;
                                horizontal-stretch: 1;
                                height: self.preferred-height;
                            }
                            if root.update-history.length == 0: Text {
                                text: @tr("尚未载入发布历史。程序将在自动检查后显示已验证记录。");
                                color: root.text-muted;
                                font-size: 14px;
                                wrap: word-wrap;
                            }
                            for entry in root.update-history: Rectangle {
                                border-radius: 8px;
                                background: root.panel-bg-soft;
                                border-color: root.panel-border;
                                border-width: 1px;
                                min-height: 110px;
                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 8px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "v" + entry.version; color: root.text-strong; font-size: 16px; font-weight: 800; }
                                        Text { text: entry.channel; color: entry.channel == "prerelease" ? root.warning : root.success; font-size: 12px; font-weight: 800; vertical-alignment: center; }
                                        Text { text: entry.published-at; color: root.text-muted; font-size: 12px; horizontal-stretch: 1; horizontal-alignment: right; vertical-alignment: center; }
                                    }
                                    Text {
                                        text: root.language-index == 1 ? entry.changelog-en : entry.changelog-zh-cn;
                                        color: root.text-body;
                                        font-size: 13px;
                                        wrap: word-wrap;
                                        min-width: 0px;
                                        width: 100%;
                                        horizontal-stretch: 1;
                                        height: self.preferred-height;
                                    }
                                }
                            }
                        }
                    }
                }

                if root.selected-page == 2: ScrollView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    viewport-width: parent.width;
                    VerticalLayout {
                        spacing: root.page-gap;

                        Rectangle {
                            border-radius: 8px;
                            background: root.panel-bg;
                            border-color: root.panel-border;
                            border-width: 1px;
                            animate background, border-color { duration: 180ms; easing: ease-out; }
                            VerticalLayout {
                                padding: 24px;
                                spacing: root.page-gap;
                                Text { text: @tr("外观"); color: root.text-strong; font-size: 18px; font-weight: 800; }
                                HorizontalLayout {
                                    spacing: root.page-gap;
                                    Text { text: @tr("主题"); width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                    SoftComboBox {
                                        accessible-name: @tr("主题");
                                                viewport-height: root.height;
                                        close-generation: root.combo-close-generation;
                                        popup-requested => { root.combo-popup-requested(); }
                                        popup-finished => { root.combo-popup-finished(); }
                                        model: [{ text: @tr("跟随系统"), enabled: true }, { text: @tr("浅色"), enabled: true }, { text: @tr("深色"), enabled: true }];
                                        current-index <=> root.theme-index;
                                        horizontal-stretch: 1;
                                        normal-background: root.combo-bg;
                                        hover-background: root.combo-bg-hover;
                                        disabled-background: root.combo-bg-disabled;
                                        selected-background: root.combo-selected-bg;
                                        normal-border: root.combo-border;
                                        hover-border: root.combo-border-hover;
                                        normal-text: root.text-body;
                                        disabled-text: root.text-soft;
                                        muted-text: root.text-muted;
                                        selected-text: root.accent-strong;
                                        selection-accepted(index, click-x, click-y) => {
                                            root.theme-selection-requested(index, click-x, click-y);
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: root.page-gap;
                                    Text { text: @tr("语言"); width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                    SoftComboBox {
                                        accessible-name: @tr("语言");
                                        viewport-height: root.height;
                                        close-generation: root.combo-close-generation;
                                        popup-requested => { root.combo-popup-requested(); }
                                        popup-finished => { root.combo-popup-finished(); }
                                        // 语言名一律用它自己的语言书写，所以这两项刻意不包 @tr()。
                                        model: [{ text: "中文", enabled: true }, { text: "English", enabled: true }];
                                        current-index <=> root.language-index;
                                        horizontal-stretch: 1;
                                        normal-background: root.combo-bg;
                                        hover-background: root.combo-bg-hover;
                                        disabled-background: root.combo-bg-disabled;
                                        selected-background: root.combo-selected-bg;
                                        normal-border: root.combo-border;
                                        hover-border: root.combo-border-hover;
                                        normal-text: root.text-body;
                                        disabled-text: root.text-soft;
                                        muted-text: root.text-muted;
                                        selected-text: root.accent-strong;
                                        // 与主题不同，语言必须回到 C++：字符串表和持久化都在那边。
                                        selection-accepted(index, click-x, click-y) => {
                                            root.language-selection-requested(index);
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: root.page-gap;
                                    Text { text: @tr("字体"); width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                    SoftComboBox {
                                        accessible-name: @tr("字体");
                                        viewport-height: root.height;
                                        max-visible-items: 10;
                                        close-generation: root.combo-close-generation;
                                        popup-requested => { root.combo-popup-requested(); }
                                        popup-finished => { root.combo-popup-finished(); }
                                        model: root.ui-font-options;
                                        current-index <=> root.ui-font-index;
                                        enabled: !root.running;
                                        horizontal-stretch: 1;
                                        height: root.control-button-height;
                                        normal-background: root.combo-bg;
                                        hover-background: root.combo-bg-hover;
                                        disabled-background: root.combo-bg-disabled;
                                        selected-background: root.combo-selected-bg;
                                        normal-border: root.combo-border;
                                        hover-border: root.combo-border-hover;
                                        normal-text: root.text-body;
                                        disabled-text: root.text-soft;
                                        muted-text: root.text-muted;
                                        selected-text: root.text-body;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            border-radius: 8px;
                            background: root.panel-bg;
                            border-color: root.panel-border;
                            border-width: 1px;
                            animate background, border-color { duration: 180ms; easing: ease-out; }
                            VerticalLayout {
                                padding: 24px;
                                spacing: root.page-gap;
                                Text { text: @tr("自动更新"); color: root.text-strong; font-size: 18px; font-weight: 800; }
                                HorizontalLayout {
                                    spacing: root.page-gap;
                                    Text { text: @tr("更新渠道"); width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                    SoftComboBox {
                                        accessible-name: @tr("更新渠道");
                                        viewport-height: root.height;
                                        close-generation: root.combo-close-generation;
                                        popup-requested => { root.combo-popup-requested(); }
                                        popup-finished => { root.combo-popup-finished(); }
                                        model: [{ text: @tr("仅稳定版"), enabled: true }, { text: @tr("稳定版和 prerelease"), enabled: true }];
                                        current-index <=> root.update-channel-index;
                                        enabled: !root.update-checking;
                                        horizontal-stretch: 1;
                                        normal-background: root.combo-bg;
                                        hover-background: root.combo-bg-hover;
                                        disabled-background: root.combo-bg-disabled;
                                        selected-background: root.combo-selected-bg;
                                        normal-border: root.combo-border;
                                        hover-border: root.combo-border-hover;
                                        normal-text: root.text-body;
                                        disabled-text: root.text-soft;
                                        muted-text: root.text-muted;
                                        selected-text: root.accent-strong;
                                        selection-accepted(index, click-x, click-y) => {
                                            root.update-channel-selection-requested(index);
                                        }
                                    }
                                }
                                CheckBox {
                                    text: @tr("显示更新日志");
                                    checked <=> root.show-update-changelog;
                                    toggled => { root.show-update-changelog-requested(self.checked); }
                                }
                                HorizontalLayout {
                                    spacing: root.page-gap;
                                    Text { text: root.update-status; color: root.text-muted; font-size: 13px; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                                }
                                Text {
                                    text: @tr("上次成功检查：") + root.update-last-successful-check;
                                    color: root.text-muted;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        Rectangle {
                            border-radius: 8px;
                            background: root.panel-bg;
                            border-color: root.panel-border;
                            border-width: 1px;
                            animate background, border-color { duration: 180ms; easing: ease-out; }
                            VerticalLayout {
                                padding: 24px;
                                spacing: root.page-gap;
                                Text { text: @tr("高级与实验功能"); color: root.text-strong; font-size: 18px; font-weight: 800; }
                                if root.wic-ui-visible: VerticalLayout {
                                    spacing: 8px;
                                    width: 100%;
                                    height: self.preferred-height;
                                    CheckBox { text: @tr("允许 WIC 兜底"); checked <=> root.allow-wic-fallback; enabled: !root.running; }
                                    Text { text: @tr("开启后，若内置的专业级 Native 解码器（如 libavif, libwebp）加载图片失败，系统将自动尝试使用 Windows WIC（Windows Imaging Component）作为兜底解码路径。"); color: root.text-muted; font-size: 13px; wrap: word-wrap; min-width: 0px; width: 100%; horizontal-stretch: 1; height: self.preferred-height; }
                                }
                                VerticalLayout {
                                    spacing: 8px;
                                    width: 100%;
                                    height: self.preferred-height;
                                    CheckBox { text: @tr("GPU 加速视觉质量"); checked <=> root.visual-quality-gpu; enabled: !root.running; }
                                    Text { text: root.visual-quality-gpu-help-text; color: root.text-muted; font-size: 13px; wrap: word-wrap; min-width: 0px; width: 100%; horizontal-stretch: 1; height: self.preferred-height; }
                                }
                                VerticalLayout {
                                    spacing: 8px;
                                    width: 100%;
                                    height: self.preferred-height;
                                    CheckBox { text: @tr("视觉质量未达标时兜底输出"); checked <=> root.visual-quality-fallback; enabled: !root.running; }
                                    Text { text: @tr("填写视觉质量后生效；未填写视觉质量时此选项保持可选，但不会参与本次编码。启用后，visual_quality 搜索没有候选达到目标时仍输出最接近目标的候选；关闭时未达标会失败。"); color: root.text-muted; font-size: 13px; wrap: word-wrap; min-width: 0px; width: 100%; horizontal-stretch: 1; height: self.preferred-height; }
                                }

                                VerticalLayout {
                                    spacing: 8px;
                                    width: 100%;
                                    height: self.preferred-height;
                                    CheckBox { text: @tr("解除 20 GiB 输入/运行时上限"); checked <=> root.unlock-max-input-file-bytes; enabled: !root.running; }
                                    Text { text: @tr("仅当前会话生效，不会写入 AWJ.jsonc。"); color: root.text-muted; font-size: 13px; wrap: word-wrap; min-width: 0px; width: 100%; horizontal-stretch: 1; height: self.preferred-height; }
                                    Text { text: @tr("警告：图片或工作集过大时可能导致内存耗尽、进程被系统杀死或整机卡死。仅在明确需要处理超大文件时临时开启。"); color: #d13438; font-size: 13px; wrap: word-wrap; font-weight: 700; min-width: 0px; width: 100%; horizontal-stretch: 1; height: self.preferred-height; }
                                }
                                VerticalLayout {
                                    spacing: 8px;
                                    width: 100%;
                                    height: self.preferred-height;
                                    CheckBox { text: @tr("启用实验性编码器（zenrav1e）"); checked <=> root.experimental-encoders; enabled: !root.running; }
                                    Text { text: @tr("启用后，构建支持时可在自动大图链路中使用 zenrav1e；普通队列自动不会选择实验编码器。不可用时相关路径会跳过或置灰。"); color: root.text-muted; font-size: 13px; wrap: word-wrap; min-width: 0px; width: 100%; horizontal-stretch: 1; height: self.preferred-height; }
                                }

                            }
                        }

                        Rectangle {
                            border-radius: 8px;
                            background: root.panel-bg;
                            border-color: root.panel-border;
                            border-width: 1px;
                            animate background, border-color { duration: 180ms; easing: ease-out; }
                            VerticalLayout {
                                padding: 24px;
                                spacing: root.page-gap;
                                Text { text: @tr("关于后端"); color: root.text-strong; font-size: 18px; font-weight: 800; }
                                Text { text: @tr("当前内置后端：原生编解码器"); color: root.text-body; font-size: 14px; wrap: word-wrap; min-width: 0px; width: 100%; }
                                Text { text: @tr("Studio 输出：libavif / AOM、svt-av1-hdr、实验 zenrav1e、WebP、JXL、JPGLI；PNG 仅 CLI 和右键菜单。"); color: root.text-body; font-size: 14px; wrap: word-wrap; min-width: 0px; width: 100%; }
                                Text { text: @tr("编码流程统一使用内置原生后端。"); color: root.text-muted; font-size: 13px; wrap: word-wrap; min-width: 0px; width: 100%; }
                            }
                        }
                    }
                }
            }
        }

        queue-menu-popup := PopupWindow {
            x: root.queue-menu-x;
            y: root.queue-menu-y;
            width: root.queue-menu-width;
            height: root.queue-menu-height;
            close-policy: close-on-click-outside;
            forward-focus: open-folder-menu;

            menu-open-timer := Timer {
                interval: 20ms;
                running: root.queue-menu-opening;
                triggered => {
                    root.queue-menu-visible = true;
                    root.queue-menu-opening = false;
                }
            }

            menu-close-timer := Timer {
                interval: 160ms;
                running: false;
                triggered => {
                    root.queue-menu-opening = false;
                    queue-menu-popup.close();
                    self.stop();
                }
            }

            Rectangle {
                x: root.queue-menu-visible ? 0px : root.queue-menu-origin-x;
                y: root.queue-menu-visible ? 0px : root.queue-menu-origin-y;
                width: root.queue-menu-visible ? parent.width : 0px;
                height: root.queue-menu-visible ? parent.height : 0px;
                border-radius: 6px;
                border-width: 1px;
                border-color: root.panel-border;
                background: root.dark-mode ? #17202c : #ffffff;
                clip: true;
                accessible-role: list;
                accessible-label: @tr("队列操作");
                animate x, y, width, height { duration: 220ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }

                VerticalLayout {
                    padding: 6px;
                    spacing: 2px;
                    open-folder-menu := QueueMenuItem {
                        dark-mode: root.dark-mode; text: @tr("打开所在位置"); enabled: root.queue-menu-valid;
                        clicked => { root.queue-menu-action(root.queue-menu-index, "open-folder"); root.queue-menu-opening = false; root.queue-menu-visible = false; menu-close-timer.restart(); }
                        navigate(action) => { if (action == "down") { open-image-menu.focus(); } if (action == "home" || action == "up") { open-folder-menu.focus(); } if (action == "end") { if (root.queue-menu-removable && !root.running) { remove-menu.focus(); } else { copy-menu.focus(); } } }
                        dismiss => { root.queue-menu-opening = false; root.queue-menu-visible = false; queue-menu-popup.close(); }
                    }
                    open-image-menu := QueueMenuItem {
                        dark-mode: root.dark-mode; text: @tr("默认方式打开图片"); enabled: root.queue-menu-valid;
                        clicked => { root.queue-menu-action(root.queue-menu-index, "open-image"); root.queue-menu-opening = false; root.queue-menu-visible = false; menu-close-timer.restart(); }
                        navigate(action) => { if (action == "up" || action == "home") { open-folder-menu.focus(); } if (action == "down") { if (root.queue-menu-editable && !root.running) { priority-menu.focus(); } else { copy-menu.focus(); } } if (action == "end") { if (root.queue-menu-removable && !root.running) { remove-menu.focus(); } else { copy-menu.focus(); } } }
                        dismiss => { root.queue-menu-opening = false; root.queue-menu-visible = false; queue-menu-popup.close(); }
                    }
                    priority-menu := QueueMenuItem {
                        dark-mode: root.dark-mode; text: @tr("优先编码"); enabled: root.queue-menu-editable && !root.running;
                        clicked => { root.queue-menu-action(root.queue-menu-index, "priority"); root.queue-menu-opening = false; root.queue-menu-visible = false; menu-close-timer.restart(); }
                        navigate(action) => { if (action == "up") { open-image-menu.focus(); } if (action == "down") { last-menu.focus(); } if (action == "home") { open-folder-menu.focus(); } if (action == "end") { if (root.queue-menu-removable) { remove-menu.focus(); } else { copy-menu.focus(); } } }
                        dismiss => { root.queue-menu-opening = false; root.queue-menu-visible = false; queue-menu-popup.close(); }
                    }
                    last-menu := QueueMenuItem {
                        dark-mode: root.dark-mode; text: @tr("最后编码"); enabled: root.queue-menu-editable && !root.running;
                        clicked => { root.queue-menu-action(root.queue-menu-index, "last"); root.queue-menu-opening = false; root.queue-menu-visible = false; menu-close-timer.restart(); }
                        navigate(action) => { if (action == "up") { priority-menu.focus(); } if (action == "down") { move-up-menu.focus(); } if (action == "home") { open-folder-menu.focus(); } if (action == "end") { if (root.queue-menu-removable) { remove-menu.focus(); } else { copy-menu.focus(); } } }
                        dismiss => { root.queue-menu-opening = false; root.queue-menu-visible = false; queue-menu-popup.close(); }
                    }
                    move-up-menu := QueueMenuItem {
                        dark-mode: root.dark-mode; text: @tr("上移"); enabled: root.queue-menu-editable && !root.running;
                        clicked => { root.queue-menu-action(root.queue-menu-index, "move-up"); root.queue-menu-opening = false; root.queue-menu-visible = false; menu-close-timer.restart(); }
                        navigate(action) => { if (action == "up") { last-menu.focus(); } if (action == "down") { move-down-menu.focus(); } if (action == "home") { open-folder-menu.focus(); } if (action == "end") { if (root.queue-menu-removable) { remove-menu.focus(); } else { copy-menu.focus(); } } }
                        dismiss => { root.queue-menu-opening = false; root.queue-menu-visible = false; queue-menu-popup.close(); }
                    }
                    move-down-menu := QueueMenuItem {
                        dark-mode: root.dark-mode; text: @tr("下移"); enabled: root.queue-menu-editable && !root.running;
                        clicked => { root.queue-menu-action(root.queue-menu-index, "move-down"); root.queue-menu-opening = false; root.queue-menu-visible = false; menu-close-timer.restart(); }
                        navigate(action) => { if (action == "up") { move-up-menu.focus(); } if (action == "down") { copy-menu.focus(); } if (action == "home") { open-folder-menu.focus(); } if (action == "end") { if (root.queue-menu-removable) { remove-menu.focus(); } else { copy-menu.focus(); } } }
                        dismiss => { root.queue-menu-opening = false; root.queue-menu-visible = false; queue-menu-popup.close(); }
                    }
                    copy-menu := QueueMenuItem {
                        dark-mode: root.dark-mode; text: @tr("复制完整路径"); enabled: root.queue-menu-valid;
                        clicked => { root.queue-menu-action(root.queue-menu-index, "copy-path"); root.queue-menu-opening = false; root.queue-menu-visible = false; menu-close-timer.restart(); }
                        navigate(action) => { if (action == "up") { if (root.queue-menu-editable && !root.running) { move-down-menu.focus(); } else { open-image-menu.focus(); } } if (action == "down" || action == "end") { if (root.queue-menu-removable && !root.running) { remove-menu.focus(); } else { copy-menu.focus(); } } if (action == "home") { open-folder-menu.focus(); } }
                        dismiss => { root.queue-menu-opening = false; root.queue-menu-visible = false; queue-menu-popup.close(); }
                    }
                    remove-menu := QueueMenuItem {
                        dark-mode: root.dark-mode; text: @tr("从队列移除"); enabled: root.queue-menu-removable && !root.running; danger: true;
                        clicked => { root.queue-menu-action(root.queue-menu-index, "remove"); root.queue-menu-opening = false; root.queue-menu-visible = false; menu-close-timer.restart(); }
                        navigate(action) => { if (action == "up") { copy-menu.focus(); } if (action == "home") { open-folder-menu.focus(); } if (action == "down" || action == "end") { remove-menu.focus(); } }
                        dismiss => { root.queue-menu-opening = false; root.queue-menu-visible = false; queue-menu-popup.close(); }
                    }
                }
            }
        }
    }
}


export component ShellConvertWindow inherits Window {
    title: @tr("AWJimage 右键转换");
    icon: @image-url("logo.png");
    default-font-family: root.ui-font-family;
    preferred-width: 840px;
    preferred-height: 560px;
    min-width: 680px;
    min-height: 440px;

    in property <[TaskRow]> task-rows;
    in-out property <string> status-text: @tr("正在准备任务…");
    in-out property <float> progress: 0.0;
    in-out property <bool> running: true;
    in-out property <bool> dark-mode: false;
    in-out property <string> ui-font-family: "";
    callback cancel-requested();
    callback force-terminate-requested();
    callback open-output-requested();

    property <color> page-bg: root.dark-mode ? #10151e : #f3f7fd;
    property <color> panel-bg: root.dark-mode ? #1b2330 : #ffffff;
    property <color> panel-border: root.dark-mode ? #303b4c : #dde7f3;
    property <color> row-bg: root.dark-mode ? #202a39 : #ffffff;
    property <color> text-strong: root.dark-mode ? #f5f8fc : #111827;
    property <color> text-body: root.dark-mode ? #dce5f1 : #334155;
    property <color> text-muted: root.dark-mode ? #a0aec2 : #64748b;
    property <color> accent: #0d6efd;
    property <color> progress-track: root.dark-mode ? #293445 : #dbe7f5;
    property <color> warning-color: root.dark-mode ? #f59e0b : #d97706;

    background: root.page-bg;

    VerticalLayout {
        padding: 20px;
        spacing: 14px;

        Text {
            text: @tr("右键转换");
            color: root.text-strong;
            font-size: 22px;
            font-weight: 800;
            horizontal-alignment: left;
        }
        Text {
            text: root.status-text;
            color: root.text-muted;
            font-size: 12px;
            horizontal-alignment: left;
            overflow: elide;
        }
        Rectangle {
            height: 6px;
            border-radius: 3px;
            background: root.progress-track;
            Rectangle {
                width: max(0px, min(parent.width, parent.width * root.progress));
                height: parent.height;
                border-radius: 3px;
                background: root.accent;
                animate width { duration: 160ms; easing: ease-out; }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            border-radius: 8px;
            background: root.panel-bg;
            border-color: root.panel-border;
            border-width: 1px;
            clip: true;
            VerticalLayout {
                spacing: 0px;

                Rectangle {
                    height: 34px;
                    background: root.dark-mode ? #222c3b : #f8fbff;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 12px;
                        Text { text: "#"; width: 32px; color: root.text-muted; font-size: 11px; vertical-alignment: center; horizontal-alignment: center; }
                        Text { text: @tr("文件"); horizontal-stretch: 1; color: root.text-muted; font-size: 11px; vertical-alignment: center; }
                        Text { text: @tr("大小"); width: 82px; color: root.text-muted; font-size: 11px; vertical-alignment: center; horizontal-alignment: center; }
                        Text { text: @tr("状态与输出"); width: 164px; color: root.text-muted; font-size: 11px; vertical-alignment: center; }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: root.panel-bg;

                    if root.task-rows.length == 0: Text {
                        text: @tr("正在准备任务…");
                        color: root.text-muted;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    if root.task-rows.length > 0: ListView {
                        for row[i] in root.task-rows: Rectangle {
                            height: 64px;
                            background: i / 2 * 2 == i ? root.row-bg : root.panel-bg;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 12px;
                                Text { text: row.order; width: 32px; color: root.text-muted; font-size: 11px; vertical-alignment: center; horizontal-alignment: center; }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 3px;
                                    Text { text: row.filename; color: root.text-body; font-size: 13px; font-weight: 700; overflow: elide; horizontal-alignment: left; }
                                    Text { text: row.folder; color: root.text-muted; font-size: 10px; overflow: elide; horizontal-alignment: left; }
                                }
                                Text { text: row.size; width: 82px; color: root.text-muted; font-size: 11px; vertical-alignment: center; horizontal-alignment: center; }
                                VerticalLayout {
                                    width: 164px;
                                    alignment: center;
                                    spacing: 3px;
                                    Text { text: row.status; color: row.warning ? root.warning-color : root.text-body; font-size: 12px; overflow: elide; horizontal-alignment: left; }
                                    Text { text: row.output.is-empty ? row.log : row.output; color: root.text-muted; font-size: 10px; overflow: elide; horizontal-alignment: left; }
                                }
                            }
                            Rectangle {
                                y: parent.height - 1px;
                                width: parent.width;
                                height: 1px;
                                background: root.panel-border;
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            height: 40px;
            spacing: 10px;
            Rectangle { horizontal-stretch: 1; background: transparent; }
            SoftButton { dark-mode: root.dark-mode; text: @tr("打开输出目录"); width: 132px; height: 40px; enabled: !root.running; clicked => { root.open-output-requested(); } }
            SoftButton { dark-mode: root.dark-mode; text: @tr("强制终止"); variant: "danger"; width: 112px; height: 40px; enabled: root.running; clicked => { root.force-terminate-requested(); } }
            SoftButton { dark-mode: root.dark-mode; text: root.running ? @tr("停止任务") : @tr("button" => "关闭"); variant: "outline"; width: 92px; height: 40px; clicked => { root.cancel-requested(); } }
        }
    }
}
