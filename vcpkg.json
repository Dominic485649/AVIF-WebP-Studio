{
  "name": "awjimage",
  "version": "0.10.4",
  "dependencies": [
    "aom",
    "dav1d",
    {
      "name": "directx-dxc",
      "platform": "!windows"
    },
    "giflib",
    "libjpeg-turbo",
    "libjxl",
    "libpng",
    {
      "name": "libraw",
      "features": [
        "dng-lossy"
      ]
    },
    "libwebp",
    {
      "name": "libyuv",
      "platform": "windows"
    },
    "scnlib",
    {
      "name": "tiff",
      "features": [
        "jpeg"
      ]
    },
    {
      "name": "vulkan-headers",
      "platform": "!windows"
    },
    {
      "name": "vulkan-loader",
      "platform": "!windows"
    }
  ]
}
